  <section id="media" class="py-16 bg-[#FAF8F5]">
    <div class="container-nh px-4">
      <div class="flex items-center justify-between mb-8">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-widest text-[#D84315]">Video Gallery</span>
          <h2 class="text-3xl font-extrabold text-[#173A7A]">Featured Media &amp; Videos</h2>
        </div>
        {videos.length > 1 && (
          <div class="flex gap-2">
            <button id="slideLeft" type="button" class="w-10 h-10 rounded-full border border-[#cbd5e1] bg-white flex items-center justify-center text-[#173A7A] hover:bg-[#FAF8F5] transition shadow-sm cursor-pointer" aria-label="Scroll left">
              &larr;
            </button>
            <button id="slideRight" type="button" class="w-10 h-10 rounded-full border border-[#cbd5e1] bg-white flex items-center justify-center text-[#173A7A] hover:bg-[#FAF8F5] transition shadow-sm cursor-pointer" aria-label="Scroll right">
              &rarr;
            </button>
          </div>
        )}
      </div>

      <div id="videoContainer" class="flex gap-6 overflow-x-auto scroll-smooth pb-4 no-scrollbar min-h-[220px] items-center">
        {videos.length > 0 ? (
          videos.map((v) => (
            <div class="min-w-[300px] sm:min-w-[360px] max-w-[360px] rounded-2xl border border-[#e2e8f0] bg-white overflow-hidden shadow-sm flex flex-col shrink-0">
              <div class="aspect-video w-full relative bg-black">
                <lite-youtube videoid={v.id} playlabel={v.title} class="w-full h-full"></lite-youtube>
              </div>
              <div class="p-4 flex-1 flex flex-col justify-between">
                <h3 class="font-bold text-[#173A7A] text-sm line-clamp-2">{v.title}</h3>
                <span class="mt-2 text-xs text-[#64748b]">Nepal Hypnosis</span>
              </div>
            </div>
          ))
        ) : (
          <div class="w-full rounded-2xl border border-[#e2e8f0] bg-white p-8 text-center">
            <p class="text-base text-[#475569]">Watch talks and short videos from Nepal Hypnosis on our YouTube channel.</p>
            <a href={site.youtubeChannelUrl} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex rounded-lg bg-[#173A7A] px-5 py-2.5 text-[13px] font-bold text-white shadow-sm hover:bg-[#102f64] transition">
              Visit our YouTube channel &rarr;
            </a>
          </div>
        )}
      </div>
    </div>
  </section>

  <script>
    const container = document.getElementById('videoContainer');
    document.getElementById('slideLeft')?.addEventListener('click', () => {
      container?.scrollBy({ left: -380, behavior: 'smooth' });
    });
    document.getElementById('slideRight')?.addEventListener('click', () => {
      container?.scrollBy({ left: 380, behavior: 'smooth' });
    });
  </script>

