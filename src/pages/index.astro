---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.ts';

const faqs = [
  {
    q: `Are you looking for a "ramro psychologist" in Kathmandu?`,
    a: `Many people search for a "ramro psychologist" (good psychologist) or "dimag ko doctor" when they feel overwhelmed. More than being "good", what matters is the right fit. In your first consultation we explain how we would work with you, and we will tell you honestly if another kind of help would suit you better.`,
  },
  {
    q: `How do I know whether therapy is right for me?`,
    a: `If something is consistently causing you distress, affecting your daily life, or if you simply feel overwhelmed and stuck, therapy provides a safe space to explore these feelings. You don't need to have everything figured out to start.`,
  },
  {
    q: `Do I need a diagnosis before seeking help?`,
    a: `Not at all. People come to therapy for many reasons, whether dealing with a specific difficulty or simply navigating a period where life feels overwhelming or unmanageable.`,
  },
  {
    q: `What happens during the first session?`,
    a: `The first session generally focuses on understanding your concerns, relevant experiences and goals, and exploring whether our service is appropriate for your needs. It is an initial conversation to help us plan a path forward together.`,
    link: { href: '/services/psychotherapy/', label: 'How psychotherapy works' },
  },
  {
    q: `What is the difference between a psychologist, a psychotherapist and a psychiatrist?`,
    a: `A psychiatrist is a medical doctor who can diagnose mental illness and prescribe medication. Psychologists and psychotherapists are trained in talking therapies and do not prescribe medicine. Some people benefit from both. If we think a medical assessment would help you, we will tell you.`,
  },
  {
    q: `Where is the clinic, and do I need an appointment?`,
    a: `The clinic is in ${site.address.display}. Visits are by appointment only (${site.hours}). Request a consultation through our portal or message us on WhatsApp and we will confirm a time.`,
  },
  {
    q: `What are your session fees and payment methods?`,
    a: `Fees depend on the type of session and the practitioner, and we tell you the fee before your first appointment. We accept cash, bank transfer and digital wallets such as eSewa and Khalti. Ask for current fees when you request a consultation.`,
  },
  {
    q: `Is everything confidential?`,
    a: `Confidentiality is a fundamental part of our professional practice. Information shared in therapy is handled in accordance with applicable ethical and professional responsibilities. The limits of confidentiality (such as immediate safety concerns) will be explained clearly during the therapeutic process.`,
    link: { href: '/clinical-standards/', label: 'Read our clinical standards' },
  },
  {
    q: `Are sessions available online as well as in-person?`,
    a: `Yes. We offer both in-person sessions at our Kathmandu clinic and secure online video consultations for clients residing outside Kathmandu or abroad.`,
  },
  {
    q: `What is clinical hypnotherapy and is it used in every session?`,
    a: `Clinical hypnotherapy uses focused attention and guided relaxation as part of therapy. You stay aware and in control throughout. It is one of several approaches we may use when it suits the person and the problem, and it is not used in every session.`,
    link: { href: '/services/clinical-hypnotherapy/', label: 'Learn about clinical hypnotherapy' },
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const videos = [];
const ytKey = import.meta.env.YOUTUBE_API_KEY;
if (ytKey) {
  try {
    const apiUrl =
      `https://www.googleapis.com/youtube/v3/playlistItems?part=snippet` +
      `&playlistId=${site.youtubeUploadsPlaylistId}&maxResults=12&key=${ytKey}`;
    const res = await fetch(apiUrl);
    if (res.ok) {
      const data = await res.json();
      for (const item of data.items ?? []) {
        const title = item.snippet?.title ?? '';
        const id = item.snippet?.resourceId?.videoId;
        if (!id || title === 'Private video' || title === 'Deleted video') continue;
        videos.push({ id, title });
        if (videos.length === 6) break;
      }
    }
  } catch (err) {
    console.warn('[index] YouTube fetch failed:', err);
  }
}
