---
import { getCollection, render } from 'astro:content';
// Replace 'Layout' with whatever layout name your homepage uses (e.g., BaseLayout, MainLayout)
import Layout from '../../layouts/BaseLayout.astro'; 
import '../../styles/global.css';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<Layout title={`${article.data.title} | Nepal Hypnosis`}>
  <main class="min-h-screen bg-slate-50 py-12 px-4 sm:px-6 lg:px-8">
    <article class="max-w-4xl mx-auto bg-white p-8 sm:p-12 rounded-xl shadow-sm border border-gray-100">
      <header class="mb-8 border-b border-gray-100 pb-6">
        <h1 class="text-3xl sm:text-4xl font-bold text-[#1a365d] tracking-tight mb-3">
          {article.data.title}
        </h1>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
          AUTHOR: {article.data.author || "ARCHANA BIBHOR"}
        </p>
      </header>

      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
        <Content />
      </div>
    </article>
  </main>
</Layout>