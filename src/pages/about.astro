---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="About Nepal Hypnosis: Psychotherapy Clinic Since 2012" 
  description="Nepal Hypnosis is a Kathmandu psychotherapy clinic and training centre, operating since 2012 and led by Archana Bibhor. Learn about our approach, team and values."
>
  <section class="bg-gradient-to-b from-[#F5F1EA] to-white pt-16 pb-12 border-b border-[#e2e8f0]">
    <div class="container-nh max-w-4xl mx-auto px-4">
      <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold text-[#173A7A] leading-tight">About Nepal Hypnosis</h1>
      <p class="mt-6 text-lg text-[#475569] leading-relaxed">
        Nepal Hypnosis is a psychotherapy clinic and training centre in Kathmandu, operating since 2012. We offer confidential, one-to-one psychotherapy and counselling, in person and online, and we train practitioners and run wellness programmes through Nepal Hypnosis Academy.
      </p>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="container-nh max-w-4xl mx-auto px-4 space-y-10 text-[#475569] leading-relaxed">
      
      <div>
        <h2 class="text-2xl font-bold text-[#173A7A] mb-4">Our approach</h2>
        <p class="mb-4">Emotional difficulties rarely have a single cause. They often develop from a mix of experiences, relationships, beliefs and ways of coping. Our eclectic framework therefore combines:</p>
        <ul class="list-disc pl-5 space-y-2">
          <li>Talk-based approaches such as CBT, person-centred and psychosocial counselling, and psychodynamic work</li>
          <li>Experiential work, including Gestalt psychotherapy</li>
          <li>Clinical hypnotherapy, where appropriate</li>
          <li>Trauma-informed, mindfulness and somatic practices</li>
        </ul>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-[#173A7A] mb-4">Our values</h2>
        <ul class="list-disc pl-5 space-y-2">
          <li><strong>Confidentiality and trust.</strong> Your privacy comes first.</li>
          <li><strong>Respect.</strong> We do not judge. Everyone is treated with dignity.</li>
          <li><strong>Honesty.</strong> We tell you what therapy can and cannot do.</li>
          <li><strong>Collaboration.</strong> You are the expert on your own life, and we work with you.</li>
        </ul>
      </div>

      <div class="bg-[#FAF8F5] p-6 rounded-2xl border border-[#e2e8f0]">
        <h2 class="text-xl font-bold text-[#173A7A] mb-3">Visit or contact us</h2>
        <ul class="space-y-2 text-sm">
          <li><strong>Address:</strong> Tangal, Kathmandu-5, Nepal</li>
          <li><strong>Hours:</strong> 10 AM to 5 PM (Strictly on appointment basis)</li>
          <li><strong>WhatsApp:</strong> +977 9841459618</li>
          <li><strong>Email:</strong> info@nepalhypnosis.com</li>
        </ul>
      </div>

    </div>
  </section>
</BaseLayout>