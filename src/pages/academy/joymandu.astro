---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Joymandu: One-Day Wellbeing Programme with a Hike in Kathmandu" 
  description="Joymandu is a one-day wellbeing programme in Kathmandu combining self-help activities at our centre with a short nature hike. Understand yourself and lift your mood."
>
  <section class="bg-gradient-to-b from-[#F5F1EA] to-white pt-16 pb-12 border-b border-[#e2e8f0]">
    <div class="container-nh max-w-4xl mx-auto px-4">
      <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold text-[#173A7A] leading-tight">Joymandu: A Journey of Joy in Kathmandu</h1>
      <p class="mt-6 text-lg text-[#475569] leading-relaxed">
        Joymandu brings together reflective self-help activities and a short hike in nature: a day to slow down, understand yourself a little better and come back lighter.
      </p>
    </div>
  </section>
  <section class="py-16 bg-[#173A7A] text-center text-white">
    <div class="container-nh max-w-3xl mx-auto px-4">
      <a href="https://portal.nepalhypnosis.com/form/consultation-request" target="_blank" class="rounded-xl bg-[#D84315] px-8 py-3.5 text-[15px] font-bold text-white shadow-md hover:bg-[#b93812] transition">Check availability and enrol</a>
    </div>
  </section>
</BaseLayout>