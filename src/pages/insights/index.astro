---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Insights & Clinical Articles" 
  description="Explore professional articles, mental health insights, and academic perspectives from practitioners at Nepal Hypnosis."
>
  <section class="bg-gradient-to-b from-[#F5F1EA] to-white pt-16 pb-12 border-b border-[#e2e8f0]">
    <div class="container-nh max-w-4xl mx-auto px-4 text-center">
      <span class="text-[11px] font-extrabold tracking-[0.2em] text-[#D84315] uppercase">Knowledge &amp; Research</span>
      <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold text-[#173A7A] leading-tight">Clinical Insights &amp; Articles</h1>
      <p class="mt-6 text-lg text-[#475569] leading-relaxed max-w-2xl mx-auto">
        Read perspectives on mental health in Nepal, therapeutic techniques, academic history, and psychological wellbeing written by our clinical team and guest professors.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container-nh max-w-5xl mx-auto px-4">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Article 1 -->
        <a href="/insights/importance-of-mental-health-interventions-in-nepal/" class="group flex flex-col justify-between rounded-2xl border border-[#e2e8f0] bg-[#FAF8F5] p-6 shadow-sm hover:shadow-md hover:border-[#173A7A] transition">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-[#D84315] mb-2">Mental Health Nepal</div>
            <h3 class="text-lg font-bold text-[#173A7A] leading-tight mb-3 group-hover:text-[#D84315] transition">The Importance of Mental Health Interventions in Nepal</h3>
            <p class="text-sm text-[#475569] line-clamp-3">Understanding the landscape of mental health, psychotherapeutic interventions, and stigma reduction in Nepal.</p>
          </div>
          <div class="mt-5 text-xs font-bold text-[#64748b]">By Archana Bibhor</div>
        </a>

        <!-- Article 2 -->
        <a href="/insights/psychological-first-aid/" class="group flex flex-col justify-between rounded-2xl border border-[#e2e8f0] bg-[#FAF8F5] p-6 shadow-sm hover:shadow-md hover:border-[#173A7A] transition">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-[#D84315] mb-2">Clinical Insights</div>
            <h3 class="text-lg font-bold text-[#173A7A] leading-tight mb-3 group-hover:text-[#D84315] transition">Psychological First Aid (PFA)</h3>
            <p class="text-sm text-[#475569] line-clamp-3">An approach to helping people affected by an emergency, disaster or traumatic event focusing on adjustment and coping.</p>
          </div>
          <div class="mt-5 text-xs font-bold text-[#64748b]">By Prof. Dr. Shishir Subba</div>
        </a>

        <!-- Article 3 -->
        <a href="/insights/cognitive-behavioral-therapy/" class="group flex flex-col justify-between rounded-2xl border border-[#e2e8f0] bg-[#FAF8F5] p-6 shadow-sm hover:shadow-md hover:border-[#173A7A] transition">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-[#D84315] mb-2">Therapeutic Modalities</div>
            <h3 class="text-lg font-bold text-[#173A7A] leading-tight mb-3 group-hover:text-[#D84315] transition">Cognitive Behavioral Therapy (CBT)</h3>
            <p class="text-sm text-[#475569] line-clamp-3">Understanding CBT, Cognitive Restructuring, and Behavioral Activation for better mental health outcomes.</p>
          </div>
          <div class="mt-5 text-xs font-bold text-[#64748b]">By Sameila Shrestha</div>
        </a>

        <!-- Article 4 -->
        <a href="/insights/psychology-in-nepal/" class="group flex flex-col justify-between rounded-2xl border border-[#e2e8f0] bg-[#FAF8F5] p-6 shadow-sm hover:shadow-md hover:border-[#173A7A] transition">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-[#D84315] mb-2">Academic Perspectives</div>
            <h3 class="text-lg font-bold text-[#173A7A] leading-tight mb-3 group-hover:text-[#D84315] transition">Psychology in Nepal: History &amp; Future</h3>
            <p class="text-sm text-[#475569] line-clamp-3">The history, academic development, and future challenges of psychology as an academic discipline in Nepal.</p>
          </div>
          <div class="mt-5 text-xs font-bold text-[#64748b]">By Prof. Dr. Shishir Subba</div>
        </a>

      </div>
    </div>
  </section>

  <section class="py-16 bg-[#FAF8F5] text-center border-t border-[#e2e8f0]">
    <div class="container-nh max-w-3xl mx-auto px-4">
      <h2 class="text-2xl font-extrabold text-[#173A7A]">Looking for Nepali Articles?</h2>
      <p class="mt-3 text-sm text-[#475569] leading-relaxed">
        Many of our articles written by senior psychologists and guest experts are published in Nepali language under our localized pathways.
      </p>
      <div class="mt-6">
        <a href="/np/insights/" class="inline-flex rounded-xl bg-[#173A7A] px-6 py-3 text-sm font-bold text-white shadow-sm hover:bg-[#102f64] transition">
          नेपाली लेखहरू हेर्नुहोस् (View Nepali Insights) →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>