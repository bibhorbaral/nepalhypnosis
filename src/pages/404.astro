---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const links = [
  { href: '/services/psychotherapy/', label: 'Psychotherapy & Counselling' },
  { href: '/services/clinical-hypnotherapy/', label: 'Clinical Hypnotherapy' },
  { href: '/services/gestalt-psychotherapy-nepal/', label: 'Gestalt Psychotherapy' },
  { href: '/services/psychosocial-counselling/', label: 'Psychosocial Counselling' },
  { href: '/insights/anxiety-support/', label: 'Anxiety Support' },
  { href: '/insights/stress-management/', label: 'Stress Management' },
  { href: '/academy/', label: 'Nepal Hypnosis Academy' },
  { href: '/about/', label: 'About Nepal Hypnosis' },
  { href: '/team/', label: 'Our Team' },
];
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found. Return to the Nepal Hypnosis homepage or choose a page below."
>
  <section class="bg-gradient-to-b from-[#F5F1EA] to-[#FAF8F5] py-16 sm:py-20">
    <div class="container-nh max-w-3xl mx-auto px-4 text-center">
      <span class="text-[11px] font-extrabold tracking-[0.2em] text-[#D84315] uppercase">Page not found</span>

      <h1 class="mt-4 font-[Poppins] text-3xl font-extrabold leading-tight text-[#173A7A] sm:text-4xl text-balance">
        We couldn't find that page.
      </h1>

      <p class="mt-4 text-base sm:text-lg text-[#475569] leading-relaxed">
        The link may be old or mistyped. You haven't done anything wrong, and you can start again from any of the pages below.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/" class="rounded-xl bg-[#173A7A] px-8 py-3.5 text-[15px] font-bold text-white shadow-md hover:bg-[#102f64] transition">
          Go to the homepage
        </a>
        <a href={site.portalUrl} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-[#D84315] px-8 py-3.5 text-[15px] font-bold text-white shadow-md hover:bg-[#b93812] transition">
          Request a Consultation
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white border-y border-[#e2e8f0] py-12">
    <div class="container-nh max-w-4xl mx-auto px-4">
      <h2 class="text-center text-xl font-extrabold text-[#173A7A]">Where would you like to go?</h2>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {links.map((l) => (
          <li>
            <a href={l.href} class="block rounded-2xl border border-[#e2e8f0] bg-[#FAF8F5] px-5 py-4 text-sm font-bold text-[#173A7A] shadow-sm hover:border-[#173A7A] hover:shadow-md transition">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-[#FAF8F5] py-12">
    <div class="container-nh max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-xl font-extrabold text-[#173A7A]">Need to reach us?</h2>
      <p class="mt-3 text-sm text-[#475569] leading-relaxed">
        <a class="font-bold text-[#173A7A] hover:underline" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp {site.phoneDisplay}</a>
        &middot;
        <a class="font-bold text-[#173A7A] hover:underline" href={`tel:${site.phoneTel}`}>Call</a>
        &middot;
        <a class="font-bold text-[#173A7A] hover:underline" href={`mailto:${site.emails.primary}`}>{site.emails.primary}</a>
      </p>
      <p class="mt-2 text-sm text-[#64748b]">{site.address.display} &middot; {site.visitPolicy} &middot; {site.hours}</p>

      <p class="mt-8 rounded-2xl border border-[#e2e8f0] bg-white p-4 text-sm text-[#475569] leading-relaxed">
        Nepal Hypnosis is not an emergency service. If you are in immediate danger or in crisis, please call
        <strong>{site.helpline}</strong> (national helpline) or go to the nearest emergency department.
      </p>
    </div>
  </section>
</BaseLayout>