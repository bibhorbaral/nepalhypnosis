---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="हाम्रो विशेषज्ञ टोली तथा नेतृत्व"
  description="संस्थापक अर्चना विभोरको नेतृत्वमा नेपाल हिप्नोसिसमा कार्यरत अनुभवी क्लिनिकल अभ्यासकर्ता, साइकोथेरापिस्ट तथा विशेषज्ञहरूसँग भेट्नुहोस्।"
  lang="np"
>

  <!-- HERO SECTION -->
  <section class="relative bg-gradient-to-b from-[#F5F1EA] to-[#FAF8F5] pt-12 pb-14 border-b border-[#e2e8f0]">
    <div class="container-nh max-w-4xl text-center mx-auto px-4">
      <span class="text-[12px] font-extrabold text-[#D84315] uppercase tracking-wider">
        व्यावसायिक नेतृत्व तथा प्राध्यापक मण्डल
      </span>
      <h1 class="mt-3 font-[Poppins] text-4xl sm:text-5xl font-extrabold text-[#173A7A] leading-tight">
        हाम्रो विशेषज्ञ टोली
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[#475569] leading-relaxed max-w-2xl mx-auto">
        हाम्रो क्लिनिकल अभ्यास कडा व्यावसायिक आचारसंहिता, निरन्तर पेसागत विकास र व्यक्तिगत आवश्यकतामा आधारित उच्चस्तरीय उपचार पद्धतिबाट निर्देशित छ।
      </p>
    </div>
  </section>

  <!-- CLINICAL TEAM GRID SECTION -->
  <section class="py-16 bg-white border-b border-[#e2e8f0]">
    <div class="container-nh max-w-6xl px-4 space-y-16">
      
      <!-- 1. ARCHANA BIBHOR -->
      <div class="grid items-center gap-10 lg:grid-cols-[0.8fr_1.2fr] bg-[#FAF8F5] p-8 sm:p-10 rounded-3xl border border-[#e2e8f0] shadow-sm">
        
        <div class="relative">
          <img 
            src="/images/archana-bibhor1.png" 
            alt="अर्चना विभोर - संस्थापक तथा प्रमुख क्लिनिकल अभ्यासकर्ता" 
            width="400" 
            height="400" 
            class="w-full rounded-2xl shadow-md object-cover max-w-[340px] mx-auto border border-[#e2e8f0]" 
          />
          <div class="absolute -bottom-3 -right-3 hidden sm:block bg-[#173A7A] text-white px-3.5 py-1.5 rounded-lg text-xs font-bold shadow-md">
            सन् २०१२ देखि कार्यरत
          </div>
        </div>

        <div>
          <span class="text-xs font-extrabold uppercase tracking-widest text-[#D84315]">संस्थापक तथा प्रमुख अभ्यासकर्ता</span>
          <h2 class="mt-1 text-3xl font-extrabold text-[#173A7A]">अर्चना विभोर</h2>
          <p class="text-base font-bold text-[#385BAA]">PsyD क्यान्डिडेट तथा वरिष्ठ साइकोथेरापिस्ट</p>
          
          <p class="mt-4 text-sm sm:text-base text-[#475569] leading-relaxed font-medium">
            अर्चना विभोर नेपाल हिप्नोसिसकी संस्थापक तथा प्रमुख क्लिनिकल अभ्यासकर्ता हुनुहुन्छ। साइकोथेरापी, मनोविमर्श तथा मानसिक स्वास्थ्य शिक्षाको क्षेत्रमा दुई दशकभन्दा बढीको व्यावसायिक अनुभवसहित, उहाँको कार्यशैली प्रत्येक सेवाग्राहीका व्यक्तिगत अनुभव, पारिवारिक तथा सम्बन्धगत पृष्ठभूमि र आन्तरिक सामर्थ्यलाई गहिराइमा बुझ्नमा केन्द्रित छ।
          </p>

          <!-- Key Metadata Grid -->
          <div class="mt-6 grid grid-cols-2 sm:grid-cols-3 gap-3 bg-white p-4 rounded-xl border border-[#e2e8f0] text-xs font-bold text-[#173A7A]">
            <div>
              <span class="block text-[10px] uppercase text-[#64748b] font-normal">स्थान (Location)</span>
              📍 काठमाडौं, नेपाल
            </div>
            <div>
              <span class="block text-[10px] uppercase text-[#64748b] font-normal">भाषा (Languages)</span>
              🗣️ नेपाली, अंग्रेजी
            </div>
            <div class="col-span-2 sm:col-span-1">
              <span class="block text-[10px] uppercase text-[#64748b] font-normal">सेवाको माध्यम (Mode)</span>
              💻 अनलाइन र 🏛️️ प्रत्यक्ष (In-Person)
            </div>
          </div>

          <div class="mt-5 space-y-2 text-xs font-medium text-[#475569]">
            <p class="flex items-center gap-2">
              <svg class="w-4 h-4 text-[#D84315] shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
              क्लिनिकल साइकोलोजीमा डक्टर अफ साइकोलोजी (PsyD) क्यान्डिडेट — युनाइटेड स्टेट्स इन्टरनेशनल युनिभर्सिटी (USIU-Africa)
            </p>
            <p class="flex items-center gap-2">
              <svg class="w-4 h-4 text-[#D84315] shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              क्लिनिकल अभ्यास, मनोविमर्शकार तालिम र मानसिक स्वास्थ्य जागरणमा २० वर्षभन्दा बढीको अनुभव
            </p>
          </div>

          <div class="mt-6">
            <a href="https://portal.nepalhypnosis.com/form/consultation-request" target="_blank" rel="noopener noreferrer" class="inline-flex rounded-xl bg-[#D84315] px-6 py-2.5 text-xs font-bold text-white shadow-md hover:bg-[#b93812] transition">
              अर्चनासँग परामर्शका लागि समय लिनुहोस् →
            </a>
          </div>

        </div>

      </div>

      <!-- 2. SHRADDHA TRIPATHI, PsyD -->
      <div class="grid items-center gap-10 lg:grid-cols-[0.8fr_1.2fr] bg-[#FAF8F5] p-8 sm:p-10 rounded-3xl border border-[#e2e8f0] shadow-sm">
        
        <div class="relative">
          <img 
            src="/images/shraddha-tripathi.png" 
            alt="डा. श्रद्धा त्रिपाठी - क्लिनिकल साइकोलोजिस्ट" 
            width="400" 
            height="400" 
            class="w-full rounded-2xl shadow-md object-cover max-w-[340px] mx-auto border border-[#e2e8f0]" 
          />
          <div class="absolute -bottom-3 -right-3 hidden sm:block bg-[#173A7A] text-white px-3.5 py-1.5 rounded-lg text-xs font-bold shadow-md">
            अनलाइन परामर्शकर्ता
          </div>
        </div>

        <div>
          <span class="text-xs font-extrabold uppercase tracking-widest text-[#D84315]">क्लिनिकल एसोसिएट</span>
          <h2 class="mt-1 text-3xl font-extrabold text-[#173A7A]">डा. श्रद्धा त्रिपाठी (PsyD)</h2>
          <p class="text-base font-bold text-[#385BAA]">क्लिनिकल साइकोलोजिस्ट</p>
          
          <p class="mt-4 text-sm sm:text-base text-[#475569] leading-relaxed font-medium">
            डा. श्रद्धा त्रिपाठीले युनाइटेड स्टेट्स इन्टरनेशनल युनिभर्सिटी (USIU-Africa) बाट क्लिनिकल साइकोलोजीमा डक्टरेट उपाधि (PsyD) हासिल गर्नुभएको छ। दुबई (यूएई) मा आधारित रहेर, उहाँले विश्वभरका सेवाग्राहीहरूलाई प्रमाण-आधारित र सांस्कृतिक रूपमा संवेदनशील अनलाइन साइकोथेरापी सेवा प्रदान गर्दै आउनुभएको छ।
          </p>

          <!-- Key Metadata Grid -->
          <div class="mt-6 grid grid-cols-2 sm:grid-cols-3 gap-3 bg-white p-4 rounded-xl border border-[#e2e8f0] text-xs font-bold text-[#173A7A]">
            <div>
              <span class="block text-[10px] uppercase text-[#64748b] font-normal">स्थान (Location)</span>
              📍 दुबई, यूएई (Dubai, UAE)
            </div>
            <div>
              <span class="block text-[10px] uppercase text-[#64748b] font-normal">भाषा (Languages)</span>
              🗣️ हिन्दी, अंग्रेजी
            </div>
            <div class="col-span-2 sm:col-span-1">
              <span class="block text-[10px] uppercase text-[#64748b] font-normal">सेवाको माध्यम (Mode)</span>
              💻 अनलाइन परामर्श (Online)
            </div>
          </div>

          <div class="mt-5 space-y-2 text-xs font-medium text-[#475569]">
            <p class="flex items-center gap-2">
              <svg class="w-4 h-4 text-[#D84315] shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
              क्लिनिकल साइकोलोजीमा डक्टर अफ साइकोलोजी (PsyD) — USIU-Africa
            </p>
            <p class="flex items-center gap-2">
              <svg class="w-4 h-4 text-[#D84315] shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              अन्तर्राष्ट्रिय सेवाग्राहीका लागि दूरस्थ (Telehealth) साइकोथेरापीमा विशेष दख्खल
            </p>
          </div>

          <div class="mt-6">
            <a href="https://portal.nepalhypnosis.com/form/consultation-request" target="_blank" rel="noopener noreferrer" class="inline-flex rounded-xl bg-[#D84315] px-6 py-2.5 text-xs font-bold text-white shadow-md hover:bg-[#b93812] transition">
              श्रद्धासँग परामर्शका लागि समय लिनुहोस् →
            </a>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- CLINICAL ETHOS & STANDARDS -->
  <section class="py-16 bg-[#FAF8F5]">
    <div class="container-nh max-w-4xl text-center px-4">
      <h2 class="text-3xl font-extrabold text-[#173A7A]">हाम्रा अभ्यासका मापदण्डहरू</h2>
      <p class="mt-4 text-base text-[#475569] leading-relaxed">
        नेपाल हिप्नोसिसमा हाम्रो विशेषज्ञ टोली तथा सहयोगीहरू कडा गोपनीयता, प्रमाण-आधारित हेरचाह र व्यावसायिक सुपरभिजन अन्तर्गत कार्य गर्छन्। हामी सम्मानजनक, सुरक्षित र पूर्वाग्रह-रहित मानसिक स्वास्थ्य सेवामा विश्वास गर्छौं।
      </p>
      
      <div class="mt-10 grid sm:grid-cols-3 gap-6 text-left">
        <div class="bg-white p-6 rounded-2xl border border-[#e2e8f0] shadow-sm">
          <h3 class="font-bold text-[#173A7A] text-base mb-2">गोपनीयता (Confidentiality)</h3>
          <p class="text-xs text-[#475569] leading-relaxed">सेवाग्राहीको व्यक्तिगत गोपनीयता र कडा पेसागत आचारसंहिताप्रति पूर्ण प्रतिबद्धता।</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-[#e2e8f0] shadow-sm">
          <h3 class="font-bold text-[#173A7A] text-base mb-2">एकीकृत दृष्टिकोण</h3>
          <p class="text-xs text-[#475569] leading-relaxed">प्रत्येक व्यक्तिको विशिष्ट आवश्यकता अनुसार उपयुक्त थेरापी विधिहरूको संयोजन।</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-[#e2e8f0] shadow-sm">
          <h3 class="font-bold text-[#173A7A] text-base mb-2">निरन्तर सिकाइ</h3>
          <p class="text-xs text-[#475569] leading-relaxed">शैक्षिक अनुसन्धान, क्लिनिकल सुपरभिजन र व्यावसायिक तालिमहरूमा सक्रिय सहभागिता।</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-[#173A7A] text-center text-white">
    <div class="container-nh max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-extrabold sm:text-4xl">आफ्नो यात्रा सुरु गर्न तयार हुनुहुन्छ?</h2>
      <p class="mt-4 text-blue-100 text-base leading-relaxed">
        चाहे तपाईं व्यक्तिगत साइकोथेरापी चाहनुहुन्छ वा व्यावसायिक तालिम लिन खोज्दै हुनुहुन्छ, हामी यहाँ सहयोगका लागि तत्पर छौं।
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="https://portal.nepalhypnosis.com/form/consultation-request" target="_blank" rel="noopener noreferrer" class="rounded-xl bg-[#D84315] px-8 py-3.5 text-[15px] font-bold text-white shadow-md hover:bg-[#b93812] transition">
          परामर्शका लागि समय लिनुहोस्
        </a>
        <a href="/np/clinical-standards" class="rounded-xl bg-white/10 px-8 py-3.5 text-[15px] font-bold text-white hover:bg-white/20 transition border border-white/20">
          नैतिक मापदण्डहरू हेर्नुहोस्
        </a>
      </div>
    </div>
  </section>

</BaseLayout>