            ←
          </button>

          <button id="slideRight" class="w-10 h-10 rounded-full border border-[#cbd5e1] bg-white flex items-center justify-center text-[#173A7A] hover:bg-[#FAF8F5] transition shadow-sm cursor-pointer" aria-label="दायाँतर्फ स्क्रोल गर्नुहोस्">
            →
          </button>

        </div>

      </div>


      <!-- Dynamic Container -->
      <div id="videoContainer" class="flex gap-6 overflow-x-auto scroll-smooth pb-4 no-scrollbar min-h-[220px] items-center">
        <p class="text-sm text-[#64748b] animate-pulse">
          YouTube च्यानलबाट नवीनतम भिडियोहरू लोड हुँदैछन्...
        </p>
      </div>

    </div>
  </section>


  <script>
    const container = document.getElementById('videoContainer');
    const btnLeft = document.getElementById('slideLeft');
    const btnRight = document.getElementById('slideRight');

    btnLeft?.addEventListener('click', () => {
      container?.scrollBy({ left: -380, behavior: 'smooth' });
    });

    btnRight?.addEventListener('click', () => {
      container?.scrollBy({ left: 380, behavior: 'smooth' });
    });

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.innerText = str;
      return div.innerHTML;
    }

    async function loadYouTubeChannelVideos() {
      if (!container) return;

      const apiKey = 'AIzaSyDs_uVXUMbewqsCD-zoInrmDOE0DXgwQ40';
      const playlistId = 'UUifKne_f3_7iydVqF91fkQA';
      const apiUrl = `https://www.googleapis.com/youtube/v3/playlistItems?part=snippet&playlistId=${playlistId}&maxResults=6&key=${apiKey}`;

      try {
        const response = await fetch(apiUrl);
        const data = await response.json();

        if (data.items && data.items.length > 0) {
          container.innerHTML = '';

          data.items.forEach(item => {
            const rawTitle = item.snippet?.title || '';
            const videoId = item.snippet?.resourceId?.videoId;

            if (!videoId || rawTitle === 'Private video' || rawTitle === 'Deleted video') return;

            const title = escapeHtml(rawTitle);
            const card = document.createElement('div');

            card.className = "min-w-[300px] sm:min-w-[360px] max-w-[360px] rounded-2xl border border-[#e2e8f0] bg-[#FAF8F5] overflow-hidden shadow-sm flex flex-col shrink-0";

            card.innerHTML = `
              <div class="aspect-video w-full bg-black relative">
                <iframe class="w-full h-full" src="https://www.youtube-nocookie.com/embed/${videoId}" title="${title}" loading="lazy" allowfullscreen></iframe>
              </div>

              <div class="p-4 flex-1 flex flex-col justify-between">
                <h3 class="font-bold text-[#173A7A] text-sm line-clamp-2">${title}</h3>
                <span class="mt-2 text-xs text-[#64748b]">नेपाल हिप्नोसिस</span>
              </div>
            `;

            container.appendChild(card);
          });

        } else {
          container.innerHTML = '<p class="text-sm text-[#64748b]">यस च्यानलमा कुनै भिडियो भेटिएन।</p>';
        }

      } catch (error) {
        console.error('Error fetching YouTube API:', error);
        container.innerHTML = '<p class="text-sm text-red-500">भिडियोहरू लोड गर्न सकिएन। कृपया पुनः प्रयास गर्नुहोस्।</p>';
      }
    }

    loadYouTubeChannelVideos();
  </script>


