---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="काठमाडौँमा साइकोथेरापी क्लिनिक तथा तालिम केन्द्र"
  description="नेपाल हिप्नोसिस सन् २०१२ देखि काठमाडौँमा सञ्चालित मनोपरामर्श, साइकोथेरापी क्लिनिक तथा तालिम केन्द्र हो।"
  lang="np"
>

<!-- 1. COMPACT HERO SECTION -->
  <section class="relative bg-gradient-to-b from-[#F5F1EA] to-[#FAF8F5] pt-10 pb-12">
    <div class="container-nh max-w-4xl mx-auto text-center">

      <!-- FIX 1: Removed tracking-[0.2em] and uppercase so Shirorekha stays connected -->
      <span class="text-[12px] font-extrabold tracking-normal text-[#D84315]">
        गोपनीय साइकोथेरापी तथा मनोविमर्श
      </span>

      <!-- FIX 2: Increased line-height to leading-[1.55] for Devanagari matra clearance -->
      <h1 class="mt-4 font-[Poppins] text-4xl font-extrabold leading-[1.55] tracking-normal text-[#173A7A] sm:text-5xl lg:text-6xl text-balance">
        मनमा गुजुल्टिएको पहाड एक्लै बोकिरहनु पर्दैन।
      </h1>

      <p class="mt-4 text-base text-[#475569] sm:text-lg max-w-2xl mx-auto leading-relaxed">
        जब मनमा कुनै कुरा अति नै गह्रौँ लाग्छ, लामो समयदेखि सताइरहन्छ वा बुझ्नै कठिन हुन्छ, तब थेरापी ले ती भावनाहरूलाई सुरक्षित वातावरणमा बुझ्न र निकासको बाटो पहिल्याउन मद्दत गर्छ।
      </p>

      <!-- Reassurance Badges -->
      <div class="mt-5 flex flex-wrap justify-center gap-6 text-sm font-bold text-[#173A7A]">

        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D84315" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          गोपनीयता मापदण्ड अनुसार
        </span>

        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D84315" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          व्यक्तिगत आवश्यकता अनुसार
        </span>

        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D84315" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
          प्रत्यक्ष (क्लिनिकमा) वा अनलाइन
        </span>

      </div>

      <!-- Action Buttons -->
      <div class="mt-7 flex flex-col items-center justify-center gap-4 sm:flex-row">

        <a href="https://portal.nepalhypnosis.com/form/consultation-request" target="_blank" rel="noopener noreferrer" class="rounded-xl bg-[#D84315] px-8 py-3.5 text-[15px] font-bold text-white shadow-md hover:bg-[#b93812] transition">
          परामर्शका लागि समय लिनुहोस्
        </a>

        <a href="#how-it-works" class="rounded-xl border border-[#cbd5e1] bg-white px-8 py-3.5 text-[15px] font-bold text-[#173A7A] hover:bg-[#f1f5f9] transition">
          थेरापी प्रक्रिया कसरी सुरु हुन्छ हेर्नुहोस् ↓
        </a>

      </div>

      <!-- HORIZONTAL GRAPHIC BANNER -->
      <div class="mt-10 relative overflow-hidden rounded-2xl border border-[#e2e8f0] shadow-sm max-w-3xl mx-auto h-[120px] sm:h-[150px]">

        <img
          src="/images/therapy_session.jpg"
          alt="नेपाल हिप्नोसिसको थेरापी वातावरण"
          width="768"
          height="150"
          class="w-full h-full object-cover object-top"
        />

        <div class="absolute inset-0 bg-gradient-to-r from-[#173A7A]/80 via-transparent to-[#173A7A]/60 flex items-center justify-between px-6 text-white">

          <div class="text-left">
            <span class="text-xs font-bold uppercase tracking-widest text-blue-200">
              सन् २०१२ देखि निरन्तर
            </span>

            <div class="text-lg font-bold">
              आत्मीय उपचार र व्यक्तिगत रूपान्तरणको सुरक्षित थलो
            </div>
          </div>

          <span class="hidden sm:inline-block rounded-full bg-white/20 backdrop-blur-md px-4 py-1.5 text-xs font-bold">
            काठमाडौँ क्लिनिक
          </span>

        </div>
      </div>

    </div>
  </section>

  <!-- 2. AUDIENCE TRIAGE PANELS -->
  <section class="py-12 bg-[#FAF8F5]">
    <div class="container-nh">

      <div class="grid md:grid-cols-2 gap-6 lg:gap-8">

        <!-- Therapy Pathway -->
        <a href="#conditions" class="group block rounded-[2rem] bg-white p-8 shadow-sm border border-[#e2e8f0] transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-[#173A7A] flex flex-col justify-between">

          <div>

            <div class="w-12 h-12 bg-[#F5F1EA] rounded-full flex items-center justify-center text-[#D84315] mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            </div>

            <h2 class="text-2xl font-extrabold text-[#173A7A]">
              म परामर्श वा सहयोग चाहन्छु
            </h2>

            <p class="mt-2 text-[#475569] leading-relaxed">
              तपाईंका भावनात्मक आवश्यकता र जीवनका अनुभवअनुसार तयार गरिने पूर्ण गोपनीय साइकोथेरापी, मनोविमर्श तथा हिप्नोथेरापी।
            </p>

          </div>

          <span class="inline-flex items-center gap-2 mt-6 font-bold text-[#D84315] group-hover:text-[#b93812] transition-transform group-hover:translate-x-1">
            थेरापीले के-कस्ता विषयमा सहयोग पुऱ्याउँछ? →
          </span>

        </a>


        <!-- Training Pathway -->
        <a href="#training" class="group block rounded-[2rem] bg-white p-8 shadow-sm border border-[#e2e8f0] transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-[#173A7A] flex flex-col justify-between">

          <div>

            <div class="w-12 h-12 bg-[#F5F1EA] rounded-full flex items-center justify-center text-[#D84315] mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
            </div>

            <h2 class="text-2xl font-extrabold text-[#173A7A]">
              म तालिम वा कोर्स गर्न चाहन्छु
            </h2>

            <p class="mt-2 text-[#475569] leading-relaxed">
              मनोविमर्श र साइकोथेरापी सम्बन्धी व्यावसायिक तालिमका साथै व्यावहारिक आत्म-विकास कार्यशाला तथा वेलनेस कार्यक्रमहरूबारे जान्नुहोस्।
            </p>

          </div>

          <span class="inline-flex items-center gap-2 mt-6 font-bold text-[#173A7A] group-hover:text-[#102f64] transition-transform group-hover:translate-x-1">
            एकेडेमीका तालिम कार्यक्रमहरू हेर्नुहोस् →
          </span>

        </a>

      </div>
    </div>
  </section>


  <!-- 3. HOW THERAPY BEGINS -->
  <section id="how-it-works" class="py-16 bg-white border-y border-[#e2e8f0]">

    <div class="container-nh max-w-5xl">

      <div class="text-center mb-14">

        <h2 class="text-3xl font-extrabold text-[#173A7A]">
          थेरापी यात्रा कसरी सुरु हुन्छ?
        </h2>

        <p class="mt-3 text-base text-[#475569]">
          पहिलो कदम चाल्न केही अप्ठ्यारो लाग्न सक्छ। यहाँ परामर्श प्रक्रियाका मुख्य चरणहरू प्रस्तुत गरिएको छ:
        </p>

      </div>

      <div class="relative">

        <div class="hidden lg:block absolute top-[28px] left-[10%] right-[10%] h-0.5 bg-[#f1f5f9] -z-10"></div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6 relative">

          <div class="relative bg-white pt-2">

            <div class="w-14 h-14 rounded-full bg-[#FAF8F5] border-2 border-[#D84315] flex items-center justify-center text-[#173A7A] font-black text-xl mb-5 mx-auto lg:mx-0 shadow-sm">
              ०१
            </div>

            <h3 class="font-bold text-[#173A7A] text-lg text-center lg:text-left">
              सम्पर्क गर्नुहोस्
            </h3>

            <p class="mt-2 text-sm text-[#475569] text-center lg:text-left leading-relaxed">
              सुरक्षित पोर्टल मार्फत प्रारम्भिक परामर्शका लागि समय लिनुहोस्।
            </p>

          </div>


          <div class="relative bg-white pt-2">

            <div class="w-14 h-14 rounded-full bg-[#FAF8F5] border-2 border-[#cbd5e1] flex items-center justify-center text-[#173A7A] font-black text-xl mb-5 mx-auto lg:mx-0 shadow-sm">
              ०२
            </div>

            <h3 class="font-bold text-[#173A7A] text-lg text-center lg:text-left">
              पहिलो कुराकानी
            </h3>

            <p class="mt-2 text-sm text-[#475569] text-center lg:text-left leading-relaxed">
              तपाईंलाई परामर्शको आवश्यकता किन महसुस भइरहेको छ र के परिवर्तन चाहनुहुन्छ भन्नेबारे खुला कुराकानी गर्नुहोस्।
            </p>

          </div>


          <div class="relative bg-white pt-2">

            <div class="w-14 h-14 rounded-full bg-[#FAF8F5] border-2 border-[#cbd5e1] flex items-center justify-center text-[#173A7A] font-black text-xl mb-5 mx-auto lg:mx-0 shadow-sm">
              ०३
            </div>

            <h3 class="font-bold text-[#173A7A] text-lg text-center lg:text-left">
              प्रारम्भिक मूल्याङ्कन
            </h3>

            <p class="mt-2 text-sm text-[#475569] text-center lg:text-left leading-relaxed">
              जीवनका अनुभव, व्यवहारका ढाँचा, व्यक्तिगत सामर्थ्य तथा वर्तमान परिस्थितिलाई गहिराइमा बुझ्ने प्रयास गरिन्छ।
            </p>

          </div>


          <div class="relative bg-white pt-2">

            <div class="w-14 h-14 rounded-full bg-[#FAF8F5] border-2 border-[#cbd5e1] flex items-center justify-center text-[#173A7A] font-black text-xl mb-5 mx-auto lg:mx-0 shadow-sm">
              ०४
            </div>

            <h3 class="font-bold text-[#173A7A] text-lg text-center lg:text-left">
              व्यक्तिगत योजना
            </h3>

            <p class="mt-2 text-sm text-[#475569] text-center lg:text-left leading-relaxed">
              तपाईंका लक्ष्यअनुसार उपयुक्त साइकोथेरापी तथा मनोविमर्श विधिहरू समावेश गरी व्यक्तिगत योजना तयार गरिन्छ।
            </p>

          </div>

        </div>
      </div>

    </div>
  </section>


  <!-- 4. NORMALIZATION & COMMON REASONS -->
  <section id="conditions" class="py-16 bg-[#FAF8F5]">

    <div class="container-nh">

      <div class="max-w-3xl mx-auto text-center">

        <h2 class="text-3xl font-extrabold sm:text-4xl text-[#173A7A] leading-snug">
          परामर्श लिन कुनै मानसिक रोग वा डायग्नोसिस (Diagnosis) हुनैपर्छ भन्ने छैन।
        </h2>

        <p class="mt-4 text-base text-[#475569] leading-relaxed">
          जीवनका विभिन्न मोडमा जोकसैले पनि मनोवैज्ञानिक कठिनाइ अनुभव गर्न सक्छन्। यस्ता समस्याहरू जीवनका उतारचढाव, सम्बन्धका जटिलताहरू, तनाव र व्यक्तिगत परिस्थितिका प्रभावका कारण उत्पन्न हुने गर्छन्।
        </p>

      </div>


      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">

        <div class="p-5 rounded-2xl bg-white border border-[#e2e8f0] shadow-sm">

          <h3 class="font-bold text-[#173A7A] text-base">
            चिन्ता तथा अत्यधिक तनाव
          </h3>

          <p class="mt-1 text-xs text-[#64748b]">
            लगातार चिन्ता (Anxiety), प्यानिक अट्याक, वा सधैँ अशान्त र तनावग्रस्त महसुस हुनु।
          </p>

        </div>


        <div class="p-5 rounded-2xl bg-white border border-[#e2e8f0] shadow-sm">

          <h3 class="font-bold text-[#173A7A] text-base">
            उदासीनता तथा डिप्रेसन
          </h3>

          <p class="mt-1 text-xs text-[#64748b]">
            जाँगर तथा ऊर्जा कम हुनु, लामो समयसम्म दुःखी रहनु, वा वरपरको वातावरणबाट अलग्गिएको महसुस हुनु।
          </p>

        </div>


        <div class="p-5 rounded-2xl bg-white border border-[#e2e8f0] shadow-sm">

          <h3 class="font-bold text-[#173A7A] text-base">
            विगतका पीडादायी अनुभव र आघात (Trauma)
          </h3>

          <p class="mt-1 text-xs text-[#64748b]">
            वर्तमान जीवनमा प्रभाव पारिरहेका विगतका पीडादायी घटना वा भावनात्मक चोटलाई बुझ्ने र व्यवस्थापन गर्ने प्रक्रिया।
          </p>

        </div>


        <div class="p-5 rounded-2xl bg-white border border-[#e2e8f0] shadow-sm">

          <h3 class="font-bold text-[#173A7A] text-base">
            सम्बन्ध र जीवनका उतारचढाव
          </h3>

          <p class="mt-1 text-xs text-[#64748b]">
            सम्बन्धमा आउने द्वन्द्व, छुट्टिनुको पीडा, शोक, वा जीवनमा आउने ठूला परिवर्तनहरूसँग जुध्नुपर्ने अवस्था।
          </p>

        </div>

      </div>

    </div>
  </section>


  <!-- 5. REFINED METAPHOR SECTION -->
  <section id="philosophy" class="py-16 bg-white border-y border-[#e2e8f0]">

    <div class="container-nh max-w-5xl">

      <div class="text-center max-w-3xl mx-auto mb-10">

        <span class="text-xs font-extrabold uppercase tracking-widest text-[#385BAA]">
          हाम्रो मूल दृष्टिकोण
        </span>

        <h2 class="mt-2 text-3xl font-extrabold sm:text-4xl text-[#173A7A] leading-snug">
          सतहमा देखिने अनुभवका पछाडि गहिरा प्रभावहरू हुन सक्छन्।
        </h2>

        <p class="mt-3 text-base text-[#475569]">
          हिमशिला (Iceberg) को उदाहरणले भावनात्मक कठिनाइहरू सतहमा तुरुन्तै नदेखिने विगतका अनुभव, सम्बन्धका ढाँचा तथा गतिशीलता, सिकिएका व्यवहार र आन्तरिक विश्वासहरूबाट कसरी प्रभावित हुन सक्छन् भन्ने कुरा बुझ्न मद्दत गर्छ। थेरापी मार्फत यी गहिरा प्रभावहरूलाई सुरक्षित ढङ्गले खोजी र सम्बोधन गर्न सकिन्छ।
        </p>

      </div>


      <div class="relative overflow-hidden rounded-3xl border border-[#cbd5e1] shadow-lg bg-gradient-to-b from-[#EBF8FF] via-[#0284C7] to-[#0A2540]">

        <div class="relative p-6 sm:p-8 bg-gradient-to-b from-[#F0F9FF] to-[#BAE6FD]/60">

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">

            <span class="inline-block self-start sm:self-auto rounded-full bg-[#D84315] px-4 py-1.5 text-xs font-extrabold uppercase text-white shadow-sm">
              सतहमा (Top)
            </span>

            <span class="text-xs font-bold text-[#173A7A] uppercase tracking-wider">
              तपाईंले अहिले प्रत्यक्ष अनुभव गरिरहनुभएका लक्षणहरू
            </span>

          </div>


          <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3">

            <div class="rounded-xl bg-white/90 p-3 text-center shadow-sm border border-sky-100">
              <div class="text-sm font-bold text-[#173A7A]">
                चिन्ता र प्यानिक (Anxiety & Panic)
              </div>
            </div>

            <div class="rounded-xl bg-white/90 p-3 text-center shadow-sm border border-sky-100">
              <div class="text-sm font-bold text-[#173A7A]">
                फोबिया र डर (Phobia)
              </div>
            </div>

            <div class="rounded-xl bg-white/90 p-3 text-center shadow-sm border border-sky-100">
              <div class="text-sm font-bold text-[#173A7A]">
                बारम्बार आउने अनिच्छित विचारहरू
              </div>
            </div>

            <div class="rounded-xl bg-white/90 p-3 text-center shadow-sm border border-sky-100">
              <div class="text-sm font-bold text-[#173A7A]">
                तनाव र दबाब (Stress)
              </div>
            </div>

          </div>

        </div>


        <div class="relative bg-[#0284C7] py-2 px-8 flex items-center justify-between text-white text-xs font-extrabold uppercase tracking-widest border-y border-white/30">

          <span class="flex items-center gap-2">
            🌊 पानीको सतह
          </span>

          <span class="hidden sm:inline">
            समस्या उत्पन्न गराउने भित्री कारकहरूको खोज
          </span>

        </div>


        <div class="p-6 sm:p-10 text-white bg-gradient-to-b from-[#0284C7]/40 to-[#0A2540]">

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-8">

            <span class="inline-block self-start sm:self-auto rounded-full bg-white/20 backdrop-blur-md px-4 py-1.5 text-xs font-bold text-sky-50 border border-white/20">
              गहिराइमा (Bottom)
            </span>

            <span class="text-xs font-bold text-sky-200 uppercase tracking-wider">
