---
import '../../styles/global.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site.ts';

const faqs = [
  {
    q: `काठमाडौंमा राम्रो मनोविज्ञ (psychologist) कसरी खोज्ने?`,
    a: `अभिभावक वा व्यक्तिहरूले तनाव वा मानसिक समस्या हुँदा 'राम्रो मनोविज्ञ' वा 'दिमागको डाक्टर' खोज्ने गर्नुहुन्छ। 'राम्रो' हुनुभन्दा पनि तपाईंको समस्या सुहाउँदो सही चिकित्सक भेट्नु महत्त्वपूर्ण हुन्छ। पहिलो परामर्श सत्रमा हामी कसरी काम गर्छौं स्पष्ट पार्छौं र अन्य सहयोग उपयुक्त भए नभएको जानकारी दिन्छौं।`,
  },
  {
    q: `थरापी (Therapy) मलाई उपयुक्त छ कि छैन भनेर कसरी थाहा पाउने?`,
    a: `यदि कुनै कुराले तपाईंलाई निरन्तर पिरोलो गरिरहेको छ, दैनिक जीवन प्रभावित भएको छ, वा तपाईं आफूलाई असहज महसुस गरिरहनुभएको छ भने थरापीले सुरक्षित ठाउँ प्रदान गर्दछ।`,
  },
  {
    q: `परामर्श लिनुभन्दा अगाडि मानसिक रोगको निदान (Diagnosis) आवश्यक छ?`,
    a: `आवश्यक छैन। मानिसहरू विभिन्न व्यक्तिगत कारणले वा जीवन असहज हुँदा परामर्श लिन आउने गर्छन्।`,
  },
  {
    q: `पहिलो सत्रमा के हुन्छ?`,
    a: `पहिलो सत्रमा मुख्यतया तपाईंका समस्याहरू, अनुभवहरू र लक्ष्यहरूबारे छलफल गरिन्छ, जसले हामीलाई आगामी बाटो तय गर्न मद्दत गर्दछ।`,
    link: { href: '/services/psychotherapy/', label: 'मनोचिकित्सा कसरी काम गर्छ' },
  },
  {
    q: `मनोविज्ञ (Psychologist) र मनोचिकित्सक (Psychiatrist) बीच के फरक छ?`,
    a: `मनोचिकित्सक (Psychiatrist) औषधि सिफारिस गर्न सक्ने चिकित्सा डाक्टर हुन् भने मनोविज्ञ वा मनोविमर्शकर्ताहरू कुराकानी र थेरापीको माध्यमबाट सेवा प्रदान गर्छन्।`,
  },
  {
    q: `क्लिनिक कहाँ अवस्थित छ र भेट्न समय लिनुपर्छ?`,
    a: `हाम्रो क्लिनिक ${site.address.display} मा छ। सेवाहरू पूर्व निर्धारित समय (Appointment) अनुसार मात्र सञ्चालन हुन्छन्।`,
  },
  {
    q: `परामर्श शुल्क र भुक्तानीका तरिकाहरू के-के हुन्?`,
    a: `शुल्क सेवाको प्रकार र विज्ञमा आधारित हुन्छ जुन पहिलो परामर्श अघि जानकारी गराइन्छ। हामी नगद, बैंक ट्रान्सफर तथा eSewa वा Khalti प्रयोग गर्छौं।`,
  },
  {
    q: `के सबै कुरा गोप्य राखिन्छ?`,
    a: `गोपनीयता हाम्रो व्यावसायिक आचारसंहिताको आधारभूत अङ्ग हो। सत्रमा साटिएका कुराहरू पूर्ण रूपमा सुरक्षित राखिन्छन्।`,
    link: { href: '/clinical-standards/', label: 'नैतिक मापदण्ड पढ्नुहोस्' },
  },
  {
    q: `के अनलाइन सेवा पनि उपलब्ध छ?`,
    a: `हो। हामी काठमाडौंस्थित क्लिनिकमा प्रत्यक्ष (In-person) र टाढा तथा विदेशमा बस्नुहुनेहरूका लागि अनलाइन भिडियो परामर्श दुवै सेवा उपलब्ध गराउँछौं।`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout 
  title="मनोचिकित्सा तथा परामर्श क्लिनिक काठमाडौं"
  description="काठमाडौंमा सुरक्षित र गोप्य मनोचिकित्सा, परामर्श तथा क्लिनिकल हिप्नोथेरापी सेवा। अर्चना विभोरद्वारा सञ्चालित।"
  lang="np"
>

  <!-- 1. COMPACT HERO SECTION WITH RESTORED BANNER -->
  <section class="relative bg-gradient-to-b from-[#F5F1EA] to-[#FAF8F5] pt-10 pb-12">
    <div class="container-nh max-w-4xl mx-auto text-center px-4">
      
      <span class="text-[11px] font-extrabold tracking-[0.2em] text-[#D84315] uppercase">
        गोप्य मनोचिकित्सा तथा परामर्श सेवा
      </span>

      <h1 class="mt-4 font-[Poppins] text-4xl font-extrabold leading-[1.15] tracking-tight text-[#173A7A] sm:text-5xl lg:text-6xl text-balance">
        तपाईंले एक्लै सबै कुरा बोक्नु पर्दैन।
      </h1>
      
      <p class="mt-3 text-lg font-bold text-[#385BAA] sm:text-xl">
        काठमाडौंमा व्यावसायिक मनोचिकित्सा तथा परामर्श।
      </p>

      <p class="mt-4 text-base text-[#475569] sm:text-lg max-w-2xl mx-auto leading-relaxed">
        जब कुनै कुरा असहज, अत्यधिक वा बुझ्न कठिन हुन्छ, तब थेरापीले सुरक्षित ठाउँ प्रदान गर्दछ।
      </p>

      <!-- Reassurance Badges -->
      <div class="mt-5 flex flex-wrap justify-center gap-6 text-sm font-bold text-[#173A7A]">
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D84315" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg> 
          गोप्य र सुरक्षित
        </span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D84315" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          व्यक्तिगत र विशेष
        </span>
        <span class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D84315" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
          प्रत्यक्ष तथा अनलाइन
        </span>
      </div>

      <!-- Action Buttons -->
      <div class="mt-7 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="https://portal.nepalhypnosis.com/form/consultation-request" target="_blank" rel="noopener noreferrer" class="rounded-xl bg-[#D84315] px-8 py-3.5 text-[15px] font-bold text-white shadow-md hover:bg-[#b93812] transition">
          परामर्श अनुरोध गर्नुहोस्
        </a>
        <a href="#how-it-works" class="rounded-xl border border-[#cbd5e1] bg-white px-8 py-3.5 text-[15px] font-bold text-[#173A7A] hover:bg-[#f1f5f9] transition">
          प्रक्रिया हेर्नुहोस् ↓
        </a>
      </div>

      <!-- RESTORED: HORIZONTAL GRAPHIC BANNER -->
      <div class="mt-10 relative overflow-hidden rounded-2xl border border-[#e2e8f0] shadow-sm max-w-3xl mx-auto h-[120px] sm:h-[150px]">
        <img src="/images/therapy_session.jpg" alt="Nepal Hypnosis Therapy Environment" width="768" height="150" class="w-full h-full object-cover object-top" />
        <div class="absolute inset-0 bg-gradient-to-r from-[#173A7A]/80 via-transparent to-[#173A7A]/60 flex items-center justify-between px-6 text-white">
          <div class="text-left">
            <span class="text-xs font-bold uppercase tracking-widest text-blue-200">सन् २०१२ देखि सञ्चालित</span>
            <div class="text-lg font-bold">सुरक्षित वातावरण र व्यावसायिक सहयोग</div>
          </div>
          <span class="hidden sm:inline-block rounded-full bg-white/20 backdrop-blur-md px-4 py-1.5 text-xs font-bold">टङ्गाल, काठमाडौं</span>
        </div>
      </div>

    </div>
  </section>

  <!-- 2. AUDIENCE TRIAGE PANELS -->
  <section class="py-12 bg-[#FAF8F5]">
    <div class="container-nh px-4">
      <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
        
        <a href="#conditions" class="group block rounded-[2rem] bg-white p-8 shadow-sm border border-[#e2e8f0] transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-[#173A7A] flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 bg-[#F5F1EA] rounded-full flex items-center justify-center text-[#D84315] mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            </div>
            <h2 class="text-2xl font-extrabold text-[#173A7A]">म परामर्श लिन चाहन्छேன்</h2>
            <p class="mt-2 text-[#475569] leading-relaxed">तपाईंका व्यक्तिगत भावनात्मक आवश्यकता र जीवन अनुभव अनुसार तयार पारिएको गोप्य मनोचिकित्सा र परामर्श सेवा।</p>
          </div>
          <span class="inline-flex items-center gap-2 mt-6 font-bold text-[#D84315] group-hover:text-[#b93812] transition-transform group-hover:translate-x-1">
            समस्याहरू र सहयोग →
          </span>
        </a>

        <a href="#training" class="group block rounded-[2rem] bg-white p-8 shadow-sm border border-[#e2e8f0] transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-[#173A7A] flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 bg-[#F5F1EA] rounded-full flex items-center justify-center text-[#D84315] mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
            </div>
            <h2 class="text-2xl font-extrabold text-[#173A7A]">म तालिम लिन चाहन्छேன்</h2>
            <p class="mt-2 text-[#475569] leading-relaxed">परामर्श तथा मनोचिकित्सा क्षेत्रमा व्यावसायिक तालिमहरू, आत्म-विकास वर्कसप र कल्याणकारी कार्यक्रमहरू।</p>
          </div>
          <span class="inline-flex items-center gap-2 mt-6 font-bold text-[#173A7A] group-hover:text-[#102f64] transition-transform group-hover:translate-x-1">
            एकेडेमी कार्यक्रमहरू हेर्नुहोस् →
          </span>
        </a>

      </div>
    </div>
  </section>

  <!-- 3. HOW THERAPY BEGINS -->
  <section id="how-it-works" class="py-16 bg-white border-y border-[#e2e8f0]">
    <div class="container-nh max-w-5xl px-4">
      <div class="text-center mb-14">
        <h2 class="text-3xl font-extrabold text-[#173A7A]">परामर्श प्रक्रिया कसरी सुरु हुन्छ?</h2>
        <p class="mt-3 text-base text-[#475569]">पहिलो कदम चाल्न गाह्रो लाग्न सक्छ। यहाँ हेर्नुहोस् हामी कसरी अगाडि बढ्छौँ।</p>
      </div>

      <div class="relative">
        <div class="hidden lg:block absolute top-[28px] left-[10%] right-[10%] h-0.5 bg-[#f1f5f9] -z-10"></div>
        
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6 relative">
          <div class="relative bg-white pt-2">
            <div class="w-14 h-14 rounded-full bg-[#FAF8F5] border-2 border-[#D84315] flex items-center justify-center text-[#173A7A] font-black text-xl mb-5 mx-auto lg:mx-0 shadow-sm">०१</div>
            <h3 class="font-bold text-[#173A7A] text-lg text-center lg:text-left">सम्पर्क गर्नुहोस्</h3>
            <p class="mt-2 text-sm text-[#475569] text-center lg:text-left leading-relaxed">सुरक्षित पोर्टलमार्फत परामर्श अनुरोध पठाउनुहोस्।</p>
          </div>
          <div class="relative bg-white pt-2">
            <div class="w-14 h-14 rounded-full bg-[#FAF8F5] border-2 border-[#cbd5e1] flex items-center justify-center text-[#173A7A] font-black text-xl mb-5 mx-auto lg:mx-0 shadow-sm">०२</div>
            <h3 class="font-bold text-[#173A7A] text-lg text-center lg:text-left">पहिलो कुराकानी</h3>
            <p class="mt-2 text-sm text-[#475569] text-center lg:text-left leading-relaxed">तपाईंलाई कस्तो महसुस भइरहेको छ र के परिवर्तन चाहनुहुन्छ कुरा गर्नुहोस्।</p>
          </div>
          <div class="relative bg-white pt-2">
            <div class="w-14 h-14 rounded-full bg-[#FAF8F5] border-2 border-[#cbd5e1] flex items-center justify-center text-[#173A7A] font-black text-xl mb-5 mx-auto lg:mx-0 shadow-sm">०३</div>
            <h3 class="font-bold text-[#173A7A] text-lg text-center lg:text-left">मूल्याङ्कन</h3>
            <p class="mt-2 text-sm text-[#475569] text-center lg:text-left leading-relaxed">तपाईंका अनुभव, परिस्थिति र बलिया पक्षहरूबारे समीक्षा गरिन्छ।</p>
          </div>
          <div class="relative bg-white pt-2">
            <div class="w-14 h-14 rounded-full bg-[#FAF8F5] border-2 border-[#cbd5e1] flex items-center justify-center text-[#173A7A] font-black text-xl mb-5 mx-auto lg:mx-0 shadow-sm">०४</div>
            <h3 class="font-bold text-[#173A7A] text-lg text-center lg:text-left">योजना</h3>
            <p class="mt-2 text-sm text-[#475569] text-center lg:text-left leading-relaxed">तपाईंको लक्ष्य अनुसार मिल्ने थेरापी विधि तय गरिन्छ।</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. NEPALI INSIGHTS SECTION -->
  <section id="insights" class="py-16 bg-[#FAF8F5]">
    <div class="container-nh px-4 max-w-5xl">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10">
        <div class="max-w-2xl">
          <span class="text-xs font-extrabold uppercase tracking-widest text-[#D84315]">लेख तथा दृष्टिकोण</span>
          <h2 class="mt-2 text-3xl font-extrabold text-[#173A7A]">मनोवैज्ञानिक लेखहरू</h2>
          <p class="mt-3 text-base text-[#475569]">समाज, परिवार, यौनिकता र आत्मसम्मानबारे हाम्रा विज्ञहरूद्वारा लिखित उपयोगी लेखहरू पढ्नुहोस्।</p>
        </div>
        <a href="/np/insights/" class="hidden sm:inline-flex items-center gap-2 text-sm font-bold text-[#173A7A] hover:text-[#D84315] transition">सबै लेखहरू हेर्नुहोस् &rarr;</a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="/np/insights/sexuality-management/" class="group flex flex-col justify-between rounded-2xl border border-[#e2e8f0] bg-white p-6 shadow-sm hover:shadow-md hover:border-[#173A7A] transition">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-[#D84315] mb-2">मनोविज्ञान र समाज</div>
            <h3 class="text-lg font-bold text-[#173A7A] leading-tight mb-3 group-hover:text-[#D84315] transition">यौनिकता व्यवस्थापन</h3>
            <p class="text-sm text-[#475569] line-clamp-3">मानिसको जीवनमा यौनसम्बन्धी उत्सुकता, व्यवस्थापन र नियन्त्रणका वैज्ञानिक उपायहरू।</p>
          </div>
          <div class="mt-5 text-xs font-bold text-[#64748b]">प्रा. डा. शान्ता निरौला</div>
        </a>

        <a href="/np/insights/how-to-guide-children/" class="group flex flex-col justify-between rounded-2xl border border-[#e2e8f0] bg-white p-6 shadow-sm hover:shadow-md hover:border-[#173A7A] transition">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-[#D84315] mb-2">अभिभावकत्व</div>
            <h3 class="text-lg font-bold text-[#173A7A] leading-tight mb-3 group-hover:text-[#D84315] transition">बालबालिकालाई कसरी मार्गदर्शन गर्ने?</h3>
            <p class="text-sm text-[#475569] line-clamp-3">अभिभावक र सन्तानबीचको सम्बन्ध, शैक्षिक दबाब, र मनोवैज्ञानिक असरहरू।</p>
          </div>
          <div class="mt-5 text-xs font-bold text-[#64748b]">अर्चना विभोर</div>
        </a>

        <a href="/np/insights/victory-over-lower-self-esteem/" class="group flex flex-col justify-between rounded-2xl border border-[#e2e8f0] bg-white p-6 shadow-sm hover:shadow-md hover:border-[#173A7A] transition sm:col-span-2 lg:col-span-1">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-[#D84315] mb-2">व्यक्तित्व विकास</div>
            <h3 class="text-lg font-bold text-[#173A7A] leading-tight mb-3 group-hover:text-[#D84315] transition">सफलताको सूत्रः न्यून आत्मसम्मानमाथिको विजय</h3>
