---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="लेखहरू तथा मनोविज्ञ दृष्टिकोण" 
  description="नेपाल हिप्नोसिसका मनोविज्ञ तथा विशेषज्ञहरूद्वारा लेखिएका मनोसामाजिक तथा मानसिक स्वास्थ्यसम्बन्धी लेखहरू।"
  lang="np"
>
  <section class="bg-gradient-to-b from-[#F5F1EA] to-white pt-16 pb-12 border-b border-[#e2e8f0]">
    <div class="container-nh max-w-4xl mx-auto px-4 text-center">
      <span class="text-[11px] font-extrabold tracking-[0.2em] text-[#D84315] uppercase">लेख तथा अनुसन्धान</span>
      <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold text-[#173A7A] leading-tight">मनोवैज्ञानिक लेखहरू</h1>
      <p class="mt-6 text-lg text-[#475569] leading-relaxed max-w-2xl mx-auto">
        नेपाली समाजमा मानसिक स्वास्थ्य, अभिभावकत्व, यौनिकता व्यवस्थापन र मनोसामाजिक समस्याहरूबारे विशेषज्ञहरूका लेखहरू।
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container-nh max-w-5xl mx-auto px-4">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <a href="/np/insights/sexuality-management/" class="group flex flex-col justify-between rounded-2xl border border-[#e2e8f0] bg-[#FAF8F5] p-6 shadow-sm hover:shadow-md hover:border-[#173A7A] transition">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-[#D84315] mb-2">मनोविज्ञान र समाज</div>
            <h3 class="text-lg font-bold text-[#173A7A] leading-tight mb-3 group-hover:text-[#D84315] transition">यौनिकता व्यवस्थापन</h3>
            <p class="text-sm text-[#475569] line-clamp-3">मानिसको जीवनमा यौनसम्बन्धी उत्सुकता, व्यवस्थापन र नियन्त्रणका उपायहरू।</p>
          </div>
          <div class="mt-5 text-xs font-bold text-[#64748b]">प्रा. डा. शान्ता निरौला</div>
        </a>

        <a href="/np/insights/how-to-guide-children/" class="group flex flex-col justify-between rounded-2xl border border-[#e2e8f0] bg-[#FAF8F5] p-6 shadow-sm hover:shadow-md hover:border-[#173A7A] transition">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-[#D84315] mb-2">अभिभावकत्व</div>
            <h3 class="text-lg font-bold text-[#173A7A] leading-tight mb-3 group-hover:text-[#D84315] transition">बालबालिकालाई कसरी मार्गदर्शन गर्ने?</h3>
            <p class="text-sm text-[#475569] line-clamp-3">अभिभावक र सन्तानबीचको सम्बन्ध, शैक्षिक दबाब, र मनोवैज्ञानिक असरहरू बारे लेख।</p>
          </div>
          <div class="mt-5 text-xs font-bold text-[#64748b]">अर्चना विभोर</div>
        </a>

        <a href="/np/insights/victory-over-lower-self-esteem/" class="group flex flex-col justify-between rounded-2xl border border-[#e2e8f0] bg-[#FAF8F5] p-6 shadow-sm hover:shadow-md hover:border-[#173A7A] transition">
          <div>
            <div class="text-[10px] font-bold uppercase tracking-widest text-[#D84315] mb-2">व्यक्तित्व विकास</div>
            <h3 class="text-lg font-bold text-[#173A7A] leading-tight mb-3 group-hover:text-[#D84315] transition">सफलताको सूत्रः न्यून आत्मसम्मानमाथिको विजय</h3>
            <p class="text-sm text-[#475569] line-clamp-3">न्यून आत्मसम्मान (Lower Self-Esteem) को कारण, लक्षण र समाधान।</p>
          </div>
          <div class="mt-5 text-xs font-bold text-[#64748b]">अर्चना विभोर</div>
        </a>

      </div>
    </div>
  </section>
</BaseLayout>