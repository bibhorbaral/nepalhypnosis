---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Nepal Hypnosis Academy: Therapy Training & Workshops" 
  description="Professional psychotherapy and counselling training plus self-help workshops in Kathmandu: self-esteem, self-hypnosis, and eclectic therapist programmes."
>
  <section class="bg-gradient-to-b from-[#F5F1EA] to-white pt-16 pb-12 border-b border-[#e2e8f0]">
    <div class="container-nh max-w-4xl mx-auto px-4">
      <span class="text-[11px] font-extrabold tracking-[0.2em] text-[#D84315] uppercase">Education & Training</span>
      <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold text-[#173A7A] leading-tight">Nepal Hypnosis Academy</h1>
      <p class="mt-6 text-lg text-[#475569] leading-relaxed">
        Nepal Hypnosis Academy is the training arm of Nepal Hypnosis. We teach in two ways: professional training for people who want to work in mental health, and self-help programmes for anyone who wants to understand themselves better and live well.
      </p>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="container-nh max-w-4xl mx-auto px-4 space-y-10 text-[#475569] leading-relaxed">
      
      <div class="grid sm:grid-cols-2 gap-8">
        <div class="p-6 rounded-2xl border border-[#e2e8f0] bg-[#FAF8F5]">
          <h2 class="text-xl font-bold text-[#173A7A] mb-3">Professional Training</h2>
          <p class="text-sm mb-4">For mental-health professionals & aspiring practitioners.</p>
          <ul class="list-disc pl-5 space-y-2 text-sm">
            <li><a href="/academy/puzzle-therapy-eclectic-therapist-training/" class="font-bold text-[#D84315] hover:underline">Puzzle Therapy: Becoming an Eclectic Therapist</a></li>
            <li>Psychosocial Counselling</li>
            <li>Gestalt Psychotherapy</li>
          </ul>
        </div>
        <div class="p-6 rounded-2xl border border-[#e2e8f0] bg-[#FAF8F5]">
          <h2 class="text-xl font-bold text-[#173A7A] mb-3">Self-Help & Growth</h2>
          <p class="text-sm mb-4">For personal development and daily resilience.</p>
          <ul class="list-disc pl-5 space-y-2 text-sm">
            <li><a href="/academy/self-esteem-training-series/" class="font-bold text-[#D84315] hover:underline">Self-Esteem Training Series</a></li>
            <li><a href="/academy/self-hypnosis-workshop/" class="font-bold text-[#D84315] hover:underline">Self Help with Self-Hypnosis</a></li>
            <li><a href="/academy/joymandu/" class="font-bold text-[#D84315] hover:underline">Joymandu: a Journey of Joy</a></li>
          </ul>
        </div>
      </div>

    </div>
  </section>

  <section class="py-16 bg-[#173A7A] text-center text-white">
    <div class="container-nh max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-extrabold">Ready to begin your training journey?</h2>
      <div class="mt-8">
        <a href="https://portal.nepalhypnosis.com/form/consultation-request" target="_blank" class="rounded-xl bg-[#D84315] px-8 py-3.5 text-[15px] font-bold text-white shadow-md hover:bg-[#b93812] transition">Enquire & Enrol Now</a>
      </div>
    </div>
  </section>
</BaseLayout>