---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Our Team & Clinical Leadership"
  description="Meet the experienced clinical practitioners, psychotherapists, and educators at Nepal Hypnosis Kathmandu, led by founder Archana Bibhor."
>

  <!-- HERO SECTION -->
  <section class="relative bg-gradient-to-b from-[#F5F1EA] to-[#FAF8F5] pt-12 pb-14 border-b border-[#e2e8f0]">
    <div class="container-nh max-w-4xl text-center mx-auto">
      <span class="text-[11px] font-extrabold tracking-[0.2em] text-[#D84315] uppercase">
        PROFESSIONAL LEADERSHIP & FACULTY
      </span>
      <h1 class="mt-3 font-[Poppins] text-4xl sm:text-5xl font-extrabold text-[#173A7A] leading-tight">
        Meet Our Team
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[#475569] leading-relaxed max-w-2xl mx-auto">
        Our practice is guided by experienced practitioners committed to rigorous clinical ethics, continuous professional development, and individualized care.
      </p>
    </div>
  </section>

  <!-- LEAD PRACTITIONER SECTION -->
  <section class="py-16 bg-white border-b border-[#e2e8f0]">
    <div class="container-nh max-w-5xl">
      <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr]">
        
        <div class="relative">
          <img 
            src="/images/archana-bibhor1.png" 
            alt="Archana Bibhor - Founder & Lead Clinical Practitioner" 
            width="400" 
            height="400" 
            class="w-full rounded-3xl shadow-lg object-cover max-w-[380px] mx-auto border border-[#e2e8f0]" 
          />
          <div class="absolute -bottom-4 -right-4 hidden sm:block bg-[#173A7A] text-white px-4 py-2 rounded-xl text-xs font-bold shadow-md">
            Est. 2012 Practitioner
          </div>
        </div>

        <div>
          <span class="text-xs font-extrabold uppercase tracking-widest text-[#D84315]">Founder & Lead Practitioner</span>
          <h2 class="mt-1 text-3xl font-extrabold text-[#173A7A]">Archana Bibhor</h2>
          <p class="text-base font-bold text-[#385BAA]">PsyD Candidate & Senior Psychotherapist</p>
          
          <p class="mt-4 text-base text-[#475569] leading-relaxed font-medium">
            Archana Bibhor is the founder and lead clinical practitioner of Nepal Hypnosis. With over two decades of professional experience in psychotherapy, counselling, and mental health education, her work emphasizes understanding each client's unique psychological landscape, relational history, and personal strengths.
          </p>

          <div class="mt-6 space-y-3 bg-[#FAF8F5] p-6 rounded-2xl border border-[#e2e8f0]">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[#D84315] shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
              <div>
                <strong class="text-[#173A7A] block text-sm">Advanced Academic Candidacy</strong>
                <span class="text-xs text-[#475569]">PsyD Candidate in Clinical Psychology — United States International University (USIU-Africa)</span>
              </div>
            </div>

            <div class="flex items-start gap-3 pt-3 border-t border-[#e2e8f0]">
              <svg class="w-5 h-5 text-[#D84315] shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              <div>
                <strong class="text-[#173A7A] block text-sm">Clinical & Educational Experience</strong>
                <span class="text-xs text-[#475569]">Over 20 years dedicated to clinical practice, counselor training, and psychological well-being programs.</span>
              </div>
            </div>
          </div>

          <div class="mt-8">
            <a href="https://portal.nepalhypnosis.com/form/consultation-request" target="_blank" rel="noopener noreferrer" class="inline-flex rounded-xl bg-[#D84315] px-7 py-3 text-sm font-bold text-white shadow-md hover:bg-[#b93812] transition">
              Request a Consultation with Archana →
            </a>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- CLINICAL ETHOS & SUPPORTING FACULTY -->
  <section class="py-16 bg-[#FAF8F5]">
    <div class="container-nh max-w-4xl text-center">
      <h2 class="text-3xl font-extrabold text-[#173A7A]">Our Practice Standards</h2>
      <p class="mt-4 text-base text-[#475569] leading-relaxed">
        At Nepal Hypnosis, our therapeutic team and associates operate under rigorous standards of confidentiality, evidence-informed care, and professional supervision. We believe in collaborative, respectful, and non-judgmental mental healthcare.
      </p>
      
      <div class="mt-10 grid sm:grid-cols-3 gap-6 text-left">
        <div class="bg-white p-6 rounded-2xl border border-[#e2e8f0] shadow-sm">
          <h3 class="font-bold text-[#173A7A] text-base mb-2">Confidentiality</h3>
          <p class="text-xs text-[#475569] leading-relaxed">Absolute adherence to client privacy and strict professional ethical boundaries.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-[#e2e8f0] shadow-sm">
          <h3 class="font-bold text-[#173A7A] text-base mb-2">Eclectic Approach</h3>
          <p class="text-xs text-[#475569] leading-relaxed">Tailoring therapeutic modalities to fit each individual's unique needs and goals.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-[#e2e8f0] shadow-sm">
          <h3 class="font-bold text-[#173A7A] text-base mb-2">Continuous Learning</h3>
          <p class="text-xs text-[#475569] leading-relaxed">Active participation in ongoing academic research, clinical supervision, and training.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-[#173A7A] text-center text-white">
    <div class="container-nh max-w-3xl mx-auto">
      <h2 class="text-3xl font-extrabold sm:text-4xl">Ready to begin your journey?</h2>
      <p class="mt-4 text-blue-100 text-base leading-relaxed">
        Whether you are seeking individual psychotherapy or exploring professional training, we are here to support you.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="https://portal.nepalhypnosis.com/form/consultation-request" target="_blank" rel="noopener noreferrer" class="rounded-xl bg-[#D84315] px-8 py-3.5 text-[15px] font-bold text-white shadow-md hover:bg-[#b93812] transition">
          Request a Consultation
        </a>
        <a href="/clinical-standards" class="rounded-xl bg-white/10 px-8 py-3.5 text-[15px] font-bold text-white hover:bg-white/20 transition border border-white/20">
          Read Clinical Standards
        </a>
      </div>
    </div>
  </section>

</BaseLayout>