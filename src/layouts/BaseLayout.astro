---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'np';
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Nepal Hypnosis Clinic & Training Center | Pioneer Eclectic Psychotherapy & Mental Well-Being Institute in Kathmandu (Est. 2012 AD)",
  lang = "en",
  image = "/images/social-preview.jpg",
  canonical,
  noindex = false
} = Astro.props;

const siteUrl = "https://nepalhypnosis.com";
const currentPath = Astro.url.pathname;
const canonicalUrl = canonical ? canonical : `${siteUrl}${currentPath}`;

const homePath = lang === 'np' ? '/np/' : '/';
const languagePath = lang === 'en' ? (currentPath === '/' ? '/np/' : `/np${currentPath}`) : (currentPath.replace(/^\/np/, '') || '/');

const htmlLang = lang === 'np' ? 'ne' : 'en';

const labels = {
  en: {
    announcement: 'Pioneer Psychotherapy Clinic & Training Center • Operating Since 2012 AD',
    conditions: 'Seeking Support',
    howItWorks: 'How it Works',
    about: 'About',
    team: 'Our Team',
    services: 'Approaches',
    training: 'Training',
    media: 'Media',
    faq: 'FAQ',
    appointment: 'Request a Consultation',
    email: 'info@nepalhypnosis.com',
    whatsappText: '+977 9841459618',
    location: 'Kathmandu, Nepal',
    footerIntro: 'Registered in 2012 AD, Nepal Hypnosis is a pioneer psychotherapy clinic and training center in Kathmandu. We provide individualized, confidential, 1-to-1 therapy through an eclectic approach tailored to each client.',
    explore: 'CLINICAL PRACTICE',
    portalTitle: 'CLIENT PORTAL',
    privacy: 'Privacy & Confidentiality',
    connect: 'CONNECT WITH US',
    notice: 'Our public website does not collect or display clinical session information. All booking-related interactions are securely handled through our dedicated client portal.',
    whoDef: '"Health is a state of complete physical, mental and social well-being and not merely the absence of disease or infirmity." — World Health Organization',
    rights: 'Nepal Hypnosis Pvt. Ltd. All rights reserved.',
    menu: 'Menu',
    close: 'Close',
    mobileCall: 'Call',
    mobileBook: 'Request Consult'
  },
  np: {
    announcement: 'नेपालको अग्रणी मनोचिकित्सा क्लिनिक तथा तालिम केन्द्र • सन् २०१२ देखि सञ्चालित',
    conditions: 'समस्याहरू',
    howItWorks: 'प्रक्रिया',
    about: 'हाम्रो बारेमा',
    team: 'हाम्रो टोली',
    services: 'उपचार विधिहरू',
    training: 'तालिम',
    media: 'मिडिया',
    faq: 'प्रश्नोत्तर',
    appointment: 'परामर्श अनुरोध गर्नुहोस्',
    email: 'info@nepalhypnosis.com',
    whatsappText: '+977 9841459618',
    location: 'काठमाडौं, नेपाल',
    footerIntro: 'सन् २०१२ (२०६९) मा दर्ता भई काठमाडौंमा सञ्चालित अग्रणी मनोचिकित्सा क्लिनिक तथा तालिम केन्द्र।',
    explore: 'क्लिनिकल सेवा',
    portalTitle: 'ग्राहक पोर्टल',
    privacy: 'गोपनीयता तथा नैतिक मापदण्ड',
    connect: 'हामीसँग जोडिनुहोस्',
    notice: 'हाम्रो सार्वजनिक वेबसाइटले क्लिनिकल सत्रको जानकारी सङ्कलन वा प्रदर्शन गर्दैन; सबै बुकिङहरू हाम्रो सुरक्षित ग्राहक पोर्टलमार्फत सञ्चालन हुन्छन्।',
    whoDef: '"स्वास्थ्य भनेको रोग वा दुर्बलताबाट मुक्ति मात्र नभई पूर्ण शारीरिक, मानसिक र सामाजिक सुस्वास्थ्यको अवस्था हो।" — विश्व स्वास्थ्य संगठन (WHO)',
    rights: 'नेपाल हिप्नोसिस प्रा. लि. सर्वाधिकार सुरक्षित।',
    menu: 'मेनु',
    close: 'बन्द गर्नुहोस्',
    mobileCall: 'सम्पर्क',
    mobileBook: 'परामर्श'
  }
};

const t = labels[lang];

const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  "name": "Nepal Hypnosis",
  "description": description,
  "url": siteUrl,
  "logo": `${siteUrl}/images/logo.jpg`,
  "telephone": "+977-9841459618",
  "email": "info@nepalhypnosis.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Kathmandu",
    "addressCountry": "NP"
  },
  "foundingDate": "2012"
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Nepal Hypnosis</title>
    <meta name="description" content={description} />
    
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${currentPath.replace(/^\/np/, '')}`} />
    <link rel="alternate" hreflang="ne" href={`${siteUrl}/np${currentPath.replace(/^\/np/, '')}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${currentPath.replace(/^\/np/, '')}`} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    <meta name="twitter:card" content="summary_large_image" />
    
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
    <meta name="theme-color" content="#102f64" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <style is:global>
      :focus-visible {
        outline: 3px solid #D84315;
        outline-offset: 3px;
        border-radius: 4px;
      }
      details[open] {
        background: #ffffff;
        border-color: #cbd5e1;
      }
      details summary {
        list-style: none;
      }
      details summary::-webkit-details-marker {
        display: none;
      }
      details summary::after {
        content: '+';
        float: right;
        color: #D84315;
        font-size: 1.25rem;
      }
      details[open] summary::after {
        content: '−';
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>

  <body class="min-h-screen bg-[#FAF8F5] pb-20 text-[16px] leading-[1.7] text-[#475569] lg:pb-0 font-sans antialiased">
    
    <!-- TOP ANNOUNCEMENT BAR -->
    <div class="hidden w-full border-0 border-b border-[#dbe5ee] bg-[#f1f7fc] lg:block">
      <div class="container-nh flex h-9 items-center justify-between text-[12px] font-medium text-[#526577]">
        <div class="flex items-center gap-2">
          <span class="inline-block h-2 w-2 rounded-full bg-[#D84315]"></span>
          <span>{t.announcement}</span>
        </div>
        <div class="flex items-center gap-6">
          <a href={`mailto:${t.email}`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 font-semibold text-[#173A7A] hover:text-[#D84315]">
            <span>✉️ {t.email}</span>
          </a>
          <a href="https://wa.me/9779841459618" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 font-semibold text-[#173A7A] hover:text-[#D84315]">
            <span>💬 {t.whatsappText}</span>
          </a>
          <span>📍 {t.location}</span>
        </div>
      </div>
    </div>

    <!-- HEADER -->
    <header class="sticky top-0 z-50 w-full border-0 border-b border-[#e2e8f0]/80 bg-white/95 backdrop-blur-xl">
      <div class="container-nh flex h-[76px] items-center justify-between gap-5">
        <a href={homePath} class="group flex min-w-0 items-center gap-3">
          <img src="/images/logo.jpg" alt="Nepal Hypnosis Logo" width="48" height="48" class="h-11 w-auto object-contain sm:h-12" />
          <div class="min-w-0">
            <div class="font-[Poppins] text-[15px] font-extrabold leading-tight tracking-tight text-[#173A7A] sm:text-[17px]">
              {lang === 'np' ? 'नेपाल हिप्नोसिस' : 'Nepal Hypnosis'}
            </div>
            <div class="mt-0.5 text-[8px] font-bold uppercase tracking-[0.13em] text-[#385BAA] sm:text-[9px]">
              {lang === 'np' ? 'मनोचिकित्सा क्लिनिक तथा तालिम केन्द्र' : 'Psychotherapy • Mental Well-being • Training'}
            </div>
          </div>
        </a>

        <!-- DESKTOP NAV -->
        <nav class="hidden items-center gap-6 lg:flex">
          <a href={lang === 'np' ? '/np/#how-it-works' : '/#how-it-works'} class="text-[14px] font-semibold text-[#475569] hover:text-[#D84315]">{t.howItWorks}</a>
          <a href={lang === 'np' ? '/np/#services' : '/#services'} class="text-[14px] font-semibold text-[#475569] hover:text-[#D84315]">{t.services}</a>
          <a href={lang === 'np' ? '/np/team' : '/team'} class="text-[14px] font-semibold text-[#475569] hover:text-[#D84315]">{t.team}</a>
          <a href={lang === 'np' ? '/np/#training' : '/#training'} class="text-[14px] font-semibold text-[#475569] hover:text-[#D84315]">{t.training}</a>
          <a href={lang === 'np' ? '/np/#media' : '/#media'} class="text-[14px] font-semibold text-[#475569] hover:text-[#D84315]">{t.media}</a>
          <a href={lang === 'np' ? '/np/#faq' : '/#faq'} class="text-[14px] font-semibold text-[#475569] hover:text-[#D84315]">{t.faq}</a>
        </nav>

        <div class="flex items-center gap-3">
          <a href={languagePath} class="hidden sm:inline-flex rounded-lg border border-[#cbd5e1] px-3 py-2 text-[12px] font-bold text-[#173A7A] hover:bg-[#f1f5f9]">
            {lang === 'en' ? 'नेपाली' : 'EN'}
          </a>
          <a href="https://portal.nepalhypnosis.com/form/consultation-request" target="_blank" rel="noopener noreferrer" class="hidden rounded-xl bg-[#D84315] px-4 py-2.5 text-[12px] font-bold text-white shadow-md hover:bg-[#b93812] lg:inline-flex">
            {t.appointment}
          </a>
          <button id="mobile-menu-btn" class="lg:hidden p-2 text-[#173A7A]" aria-label={t.menu} aria-expanded="false" aria-controls="mobile-menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- MOBILE MENU OVERLAY -->
    <div id="mobile-menu" class="fixed inset-0 z-[100] bg-white transform translate-x-full transition-transform duration-300 lg:hidden flex flex-col" hidden>
      <div class="flex items-center justify-between p-5 border-b border-[#e2e8f0]">
        <span class="font-[Poppins] text-[15px] font-extrabold text-[#173A7A]">{t.menu}</span>
        <button id="close-menu-btn" class="p-2 text-[#475569]" aria-label={t.close}>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <nav class="flex-1 overflow-y-auto p-5 flex flex-col gap-5 text-lg font-bold text-[#173A7A]">
        <a href={lang === 'np' ? '/np/#conditions' : '/#conditions'} class="mobile-link block border-b border-[#f1f5f9] pb-3">{t.conditions}</a>
        <a href={lang === 'np' ? '/np/#how-it-works' : '/#how-it-works'} class="mobile-link block border-b border-[#f1f5f9] pb-3">{t.howItWorks}</a>
        <a href={lang === 'np' ? '/np/#services' : '/#services'} class="mobile-link block border-b border-[#f1f5f9] pb-3">{t.services}</a>
        <a href={lang === 'np' ? '/np/team' : '/team'} class="mobile-link block border-b border-[#f1f5f9] pb-3">{t.team}</a>
        <a href={lang === 'np' ? '/np/#training' : '/#training'} class="mobile-link block border-b border-[#f1f5f9] pb-3">{t.training}</a>
        <a href={lang === 'np' ? '/np/#media' : '/#media'} class="mobile-link block border-b border-[#f1f5f9] pb-3">{t.media}</a>
        <a href={lang === 'np' ? '/np/#faq' : '/#faq'} class="mobile-link block border-b border-[#f1f5f9] pb-3">{t.faq}</a>
        <a href={languagePath} class="block border-b border-[#f1f5f9] pb-3 text-[#385BAA]">🌐 {lang === 'en' ? 'नेपालीमा हेर्नुहोस्' : 'View in English'}</a>
      </nav>
    </div>

    <!-- MOBILE STICKY BOTTOM BAR -->
    <div class="fixed bottom-0 left-0 right-0 z-50 flex items-center justify-between border-t border-[#e2e8f0] bg-white px-4 py-3 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] lg:hidden">
      <a href="https://wa.me/9779841459618" target="_blank" rel="noopener noreferrer" class="flex w-1/2 items-center justify-center gap-2 border-r border-[#e2e8f0] text-sm font-bold text-[#173A7A]">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        {t.mobileCall}
      </a>
      <a href="https://portal.nepalhypnosis.com/form/consultation-request" target="_blank" rel="noopener noreferrer" class="flex w-1/2 items-center justify-center gap-2 text-sm font-bold text-[#D84315]">
        {t.mobileBook} →
      </a>
    </div>

    <main id="main-content">
      <slot />
    </main>

    <!-- FOOTER WITH SOCIAL MEDIA ICONS INTEGRATED -->
    <footer class="bg-[#102f64] text-white">
      <div class="container-nh grid gap-12 py-16 md:grid-cols-[1.4fr_0.8fr_0.8fr]">
        <div>
          <div class="mb-5 flex items-center gap-3">
            <img src="/images/logo.jpg" alt="Nepal Hypnosis" width="48" height="48" class="h-12 w-auto rounded-lg bg-white p-1" />
            <div>
              <div class="font-[Poppins] text-sm font-extrabold">{lang === 'np' ? 'नेपाल हिप्नोसिस' : 'Nepal Hypnosis'}</div>
              <div class="text-[9px] font-bold uppercase tracking-widest text-blue-200">
                {lang === 'np' ? 'मनोचिकित्सा क्लिनिक तथा तालिम केन्द्र' : 'Psychotherapy Clinic & Training Center'}
              </div>
            </div>
          </div>
          <p class="max-w-md text-sm leading-relaxed text-blue-100">{t.footerIntro}</p>
          
          <!-- Social Media Profiles Section -->
          <div class="mt-6">
            <div class="text-[11px] font-bold uppercase tracking-wider text-blue-200 mb-2.5">{t.connect}</div>
            <div class="flex items-center gap-2.5">
              <a href="https://www.facebook.com/nepalhypnotherapy/" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-white/10 p-2 text-white transition hover:bg-[#1877F2]" aria-label="Facebook">
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href="https://x.com/nepalhypnosis" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-white/10 p-2 text-white transition hover:bg-black" aria-label="X (Twitter)">
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href="https://www.linkedin.com/in/nepalhypnosis/" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-white/10 p-2 text-white transition hover:bg-[#0A66C2]" aria-label="LinkedIn">
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.74a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/></svg>
              </a>
              <a href="https://www.instagram.com/nepalhypnosis" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-white/10 p-2 text-white transition hover:bg-[#E4405F]" aria-label="Instagram">
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
            </div>
          </div>

          <blockquote class="mt-5 border-l-2 border-[#D84315] pl-3 text-xs italic text-blue-200">{t.whoDef}</blockquote>
        </div>

        <div>
          <h3 class="mb-5 text-xs font-bold uppercase tracking-wider text-white">{t.explore}</h3>
          <ul class="space-y-3 text-sm text-blue-100">
            <li><a href={lang === 'np' ? '/np/#conditions' : '/#conditions'} class="hover:text-white">{t.conditions}</a></li>
            <li><a href={lang === 'np' ? '/np/#about' : '/#about'} class="hover:text-white">{t.about}</a></li>
            <li><a href={lang === 'np' ? '/np/#services' : '/#services'} class="hover:text-white">{t.services}</a></li>
            <li><a href={lang === 'np' ? '/np/#training' : '/#training'} class="hover:text-white">{t.training}</a></li>
            <li><a href={lang === 'np' ? '/np/#media' : '/#media'} class="hover:text-white">{t.media}</a></li>
            <li><a href={lang === 'np' ? '/np/#faq' : '/#faq'} class="hover:text-white">{t.faq}</a></li>
          </ul>
        </div>

        <div>
          <h3 class="mb-5 text-xs font-bold uppercase tracking-wider text-white">{t.portalTitle}</h3>
          <p class="mb-5 text-sm leading-relaxed text-blue-100">{t.notice}</p>
          <a href="https://portal.nepalhypnosis.com/form/consultation-request" target="_blank" rel="noopener noreferrer" class="inline-flex rounded-lg border border-blue-300/40 px-4 py-2.5 text-xs font-bold text-white hover:bg-white/10 transition">
            {lang === 'np' ? 'ग्राहक पोर्टल →' : 'Client Portal →'}
          </a>
        </div>
      </div>

      <div class="border-t border-white/10 bg-[#0c244d] py-6 text-center text-[12px] text-blue-200">
        <div class="container-nh">
          {lang === 'np' ? (
            <p class="mb-3 rounded-lg bg-red-900/40 px-4 py-3 inline-block border border-red-800/50">
              🚨 <span class="font-bold text-white">आपत्कालीन सूचना:</span> नेपाल हिप्नोसिस आपत्कालीन वा संकटकालीन सेवा प्रदायक संस्था होइन। यदि तपाईं वा कसैलाई तत्काल गम्भीर मानसिक संकट परेको छ भने, कृपया निःशुल्क राष्ट्रिय हेल्पलाइन <strong class="text-white text-[14px]">११६६ (1166)</strong> मा फोन गर्नुहोस् वा नजिकैको अस्पतालको आपत्कालीन (Emergency) कक्षमा जानुहोस्।
            </p>
          ) : (
            <p class="mb-3 rounded-lg bg-red-900/40 px-4 py-3 inline-block border border-red-800/50">
              🚨 <span class="font-bold text-white">Emergency Notice:</span> Nepal Hypnosis is not an emergency crisis-response service. If you are experiencing an immediate mental health crisis, call <strong class="text-white text-[14px]">1166</strong> (Free National Helpline) or visit the nearest emergency department.
            </p>
          )}
          <p class="text-blue-300/80">© {new Date().getFullYear()} {t.rights}</p>
        </div>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const closeBtn = document.getElementById('close-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileLinks = document.querySelectorAll('.mobile-link');

      function openMenu() {
        mobileMenu.hidden = false;
        requestAnimationFrame(() => {
          mobileMenu.classList.remove('translate-x-full');
          menuBtn.setAttribute('aria-expanded', 'true');
        });
      }

      function closeMenu() {
        mobileMenu.classList.add('translate-x-full');
        menuBtn.setAttribute('aria-expanded', 'false');
        setTimeout(() => { mobileMenu.hidden = true; }, 300);
      }

      menuBtn?.addEventListener('click', openMenu);
      closeBtn?.addEventListener('click', closeMenu);
      mobileLinks.forEach(link => { link.addEventListener('click', closeMenu); });
    </script>
  </body>
</html>
