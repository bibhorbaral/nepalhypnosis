---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'np';
  image?: string;
  canonical?: string;
  noindex?: boolean;
  pageSchema?: object;
}

const {
  title,
  description = "Confidential psychotherapy, counselling and clinical hypnotherapy in Kathmandu, with in-person and online sessions. Led by Archana Bibhor, 20+ years' experience. Book a consultation.",
  lang = "en",
  image = "/images/social-preview.jpg",
  canonical,
  noindex = false,
  pageSchema
} = Astro.props;

const siteUrl = "https://nepalhypnosis.com";
const currentPath = Astro.url.pathname;
const canonicalUrl = canonical ? canonical : `${siteUrl}${currentPath}`;

const homePath = lang === 'np' ? '/np/' : '/';
const languagePath = lang === 'en' ? (currentPath === '/' ? '/np/' : `/np${currentPath}`) : (currentPath.replace(/^\/np/, '') || '/');

const htmlLang = lang === 'np' ? 'ne' : 'en';

const labels = {
  en: {
    announcement: 'Psychotherapy Clinic & Training Center • Operating Since 2012 AD',
    conditions: 'Seeking Support',
    howItWorks: 'Process',
    about: 'About',
    team: 'Team',
    services: 'Services',
    training: 'Academy',
    insights: 'Insights & Articles',
    media: 'Media',
    faq: 'FAQ',
    appointment: 'Request a Consultation',
    email: 'info@nepalhypnosis.com',
    whatsappText: '+977 9841459618',
    location: 'Tangal, Kathmandu-5, Nepal (Appointment Only)',
    footerIntro: 'Registered in 2012 AD, Nepal Hypnosis is a psychotherapy clinic and training center in Kathmandu. We provide individualized, confidential, 1-to-1 therapy through an eclectic approach tailored to each client.',
    explore: 'EXPLORE',
    servicesHeading: 'APPROACHES & INSIGHTS',
    academyHeading: 'TRAINING & ACADEMY',
    portalTitle: 'CLIENT PORTAL',
    privacy: 'Privacy & Confidentiality',
    connect: 'CONNECT WITH US',
    notice: 'Our public website does not collect or display clinical session information. All booking-related interactions are securely handled through our dedicated client portal.',
    whoDef: '"Health is a state of complete physical, mental and social well-being and not merely the absence of disease or infirmity." — World Health Organization',
    rights: 'Nepal Hypnosis Pvt. Ltd. All rights reserved.',
    menu: 'Menu',
    close: 'Close',
    mobileCall: 'Call',
    mobileBook: 'Request Consult'
  },
  np: {
    announcement: 'नेपालको अग्रणी मनोचिकित्सा क्लिनिक तथा तालिम केन्द्र • सन् २०१२ देखि सञ्चालित',
    conditions: 'समस्याहरू',
    howItWorks: 'प्रक्रिया',
    about: 'हाम्रो बारेमा',
    team: 'टोली',
    services: 'उपचार विधिहरू',
    training: 'एकेडेमी',
    insights: 'लेखहरू',
    media: 'मिडिया',
    faq: 'प्रश्नोत्तर',
    appointment: 'परामर्श अनुरोध गर्नुहोस्',
    email: 'info@nepalhypnosis.com',
    whatsappText: '+977 9841459618',
    location: 'टङ्गाल, काठमाडौं-५, नेपाल',
    footerIntro: 'सन् २०१२ (२०६९) मा दर्ता भई काठमाडौंमा सञ्चालित अग्रणी मनोचिकित्सा क्लिनिक तथा तालिम केन्द्र।',
    explore: 'मुख्य पृष्ठहरू',
    servicesHeading: 'उपचार विधि र लेखहरू',
    academyHeading: 'तालिम र एकेडेमी',
    portalTitle: 'ग्राहक पोर्टल',
    privacy: 'गोपनीयता तथा नैतिक मापदण्ड',
    connect: 'हामीसँग जोडिनुहोस्',
    notice: 'हाम्रो सार्वजनिक वेबसाइटले क्लिनिकल सत्रको जानकारी सङ्कलन वा प्रदर्शन गर्दैन; सबै बुकिङहरू हाम्रो सुरक्षित ग्राहक पोर्टलमार्फत सञ्चालन हुन्छन्।',
    whoDef: '"स्वास्थ्य भनेको रोग वा दुर्बलताबाट मुक्ति मात्र नभई पूर्ण शारीरिक, मानसिक र सामाजिक सुस्वास्थ्यको अवस्था हो।" — विश्व स्वास्थ्य संगठन (WHO)',
    rights: 'नेपाल हिप्नोसिस प्रा. लि. सर्वाधिकार सुरक्षित।',
    menu: 'मेनु',
    close: 'बन्द गर्नुहोस्',
    mobileCall: 'सम्पर्क',
    mobileBook: 'परामर्श'
  }
};

const t = labels[lang];

const defaultSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalClinic",
      "@id": `${siteUrl}/#clinic`,
      "name": "Nepal Hypnosis",
      "description": description,
      "url": siteUrl,
      "logo": `${siteUrl}/images/logo.jpg`,
      "telephone": "+977-9841459618",
      "email": ["info@nepalhypnosis.com", "mailhypnosis@gmail.com"],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Tangal",
        "addressLocality": "Kathmandu-5",
        "addressCountry": "NP"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "27.7196",
        "longitude": "85.3289"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "10:00",
          "closes": "17:00"
        }
      ],
      "foundingDate": "2012"
    },
    {
      "@type": "EducationalOrganization",
      "@id": `${siteUrl}/#academy`,
      "name": "Nepal Hypnosis Academy",
      "url": `${siteUrl}/academy/`,
      "telephone": "+977-9841459618",
      "parentOrganization": {
        "@id": `${siteUrl}/#clinic`
      }
    }
  ]
};

const activeSchema = pageSchema || defaultSchema;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Nepal Hypnosis</title>
    <meta name="description" content={description} />
    
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${currentPath.replace(/^\/np/, '')}`} />
    <link rel="alternate" hreflang="ne" href={`${siteUrl}/np${currentPath.replace(/^\/np/, '')}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${currentPath.replace(/^\/np/, '')}`} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    <meta name="twitter:card" content="summary_large_image" />
    
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
    <meta name="theme-color" content="#102f64" />

    <script type="application/ld+json" set:html={JSON.stringify(activeSchema)} />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@justinribeiro/lite-youtube-embed@2.1.2/lite-youtube.css" />
    <script type="module" src="https://cdn.jsdelivr.net/npm/@justinribeiro/lite-youtube-embed@2.1.2/lite-youtube.js"></script>

    <style is:global>
      :focus-visible {
        outline: 3px solid #D84315;
        outline-offset: 3px;
        border-radius: 4px;
      }
      details[open] {
        background: #ffffff;
        border-color: #cbd5e1;
      }
      details summary {
        list-style: none;
      }
      details summary::-webkit-details-marker {
        display: none;
      }
      details summary::after {
        content: '+';
        float: right;
        color: #D84315;
        font-size: 1.25rem;
      }
      details[open] summary::after {
        content: '−';
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>

  <body class="min-h-screen bg-[#FAF8F5] pb-20 text-[16px] leading-[1.7] text-[#475569] lg:pb-0 font-sans antialiased">
    
    <div class="hidden w-full border-0 border-b border-[#dbe5ee] bg-[#f1f7fc] lg:block">
      <div class="container-nh flex h-9 items-center justify-between text-[12px] font-medium text-[#526577]">
        <div class="flex items-center gap-2">
          <span class="inline-block h-2 w-2 rounded-full bg-[#D84315]"></span>
          <span>{t.announcement}</span>
        </div>
        <div class="flex items-center gap-6">
          <a href={`mailto:${t.email}`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 font-semibold text-[#173A7A] hover:text-[#D84315]">
            <span>✉ {t.email}</span>
          </a>
          <a href="https://wa.me/9779841459618" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 font-semibold text-[#173A7A] hover:text-[#D84315]">
            <span>💬 {t.whatsappText}</span>
          </a>
          <span>📍 {t.location}</span>
        </div>
      </div>
    </div>

    <header class="sticky top-0 z-50 w-full border-0 border-b border-[#e2e8f0]/80 bg-white/95 backdrop-blur-xl">
      <div class="container-nh flex h-[76px] items-center justify-between gap-4">
        <a href={homePath} class="group flex min-w-0 items-center gap-3">
          <img src="/images/logo.jpg" alt="Nepal Hypnosis Logo" width="48" height="48" class="h-11 w-auto object-contain sm:h-12" />
          <div class="min-w-0">
            <div class="font-[Poppins] text-[15px] font-extrabold leading-tight tracking-tight text-[#173A7A] sm:text-[17px]">
              {lang === 'np' ? 'नेपाल हिप्नोसिस' : 'Nepal Hypnosis'}
            </div>
            <div class="mt-0.5 text-[8px] font-bold uppercase tracking-[0.13em] text-[#385BAA] sm:text-[9px]">
              {lang === 'np' ? 'मनोचिकित्सा क्लिनिक तथा तालिम केन्द्र' : 'Psychotherapy • Mental Well-being • Training'}
            </div>
          </div>
        </a>

        <!-- Desktop Navigation without Insights link -->
        <nav class="hidden items-center gap-5 lg:flex">
          <a href={lang === 'np' ? '/np/#how-it-works' : '/#how-it-works'} class="text-[13px] font-semibold text-[#475569] hover:text-[#D84315]">{t.howItWorks}</a>
          <a href={lang === 'np' ? '/np/#services' : '/#services'} class="text-[13px] font-semibold text-[#475569] hover:text-[#D84315]">{t.services}</a>
          <a href={lang === 'np' ? '/np/team' : '/team'} class="text-[13px] font-semibold text-[#475569] hover:text-[#D84315]">{t.team}</a>
          <a href={lang === 'np' ? '/np/#training' : '/#training'} class="text-[13px] font-semibold text-[#475569] hover:text-[#D84315]">{t.training}</a>
          <a href={lang === 'np' ? '/np/#media' : '/#media'} class="text-[13px] font-semibold text-[#475569] hover:text-[#D84315]">{t.media}</a>
          <a href={lang === 'np' ? '/np/#faq' : '/#faq'} class="text-[13px] font-semibold text-[#475569] hover:text-[#D84315]">{t.faq}</a>
        </nav>

        <div class="flex items-center gap-3">
          <a href={languagePath} class="hidden sm:inline-flex rounded-lg border border-[#cbd5e1] px-3 py-2 text-[12px] font-bold text-[#173A7A] hover:bg-[#f1f5f9]">
            {lang === 'en' ? 'नेपाली' : 'EN'}
          </a>
          <a href="https://portal.nepalhypnosis.com/form/consultation-request" target="_blank" rel="noopener noreferrer" class="hidden rounded-xl bg-[#D84315] px-4 py-2.5 text-[12px] font-bold text-white shadow-md hover:bg-[#b93812] lg:inline-flex">
            {t.appointment}
          </a>
          <button id="mobile-menu-btn" class="lg:hidden p-2 text-[#173A7A]" aria-label={t.menu} aria-expanded="false" aria-controls="mobile-menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Menu Overlay without Insights link -->
    <div id="mobile-menu" class="fixed inset-0 z-[100] bg-white transform translate-x-full transition-transform duration-300 lg:hidden flex flex-col" hidden>
      <div class="flex items-center justify-between p-5 border-b border-[#e2e8f0]">
        <span class="font-[Poppins] text-[15px] font-extrabold text-[#173A7A]">{t.menu}</span>
        <button id="close-menu-btn" class="p-2 text-[#475569]" aria-label={t.close}>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <nav class="flex-1 overflow-y-auto p-5 flex flex-col gap-4 text-base font-bold text-[#173A7A]">
        <a href={lang === 'np' ? '/np/#how-it-works' : '/#how-it-works'} class="mobile-link block">{t.howItWorks}</a>
        <a href={lang === 'np' ? '/np/#services' : '/#services'} class="mobile-link block">{t.services}</a>
        <a href={lang === 'np' ? '/np/team' : '/team'} class="mobile-link block">{t.team}</a>
        <a href={lang === 'np' ? '/np/#training' : '/#training'} class="mobile-link block">{t.training}</a>
        <a href={lang === 'np' ? '/np/#media' : '/#media'} class="mobile-link block">{t.media}</a>
        <a href={lang === 'np' ? '/np/#faq' : '/#faq'} class="mobile-link block">{t.faq}</a>
        <a href={languagePath} class="block mt-4 text-center rounded-lg bg-[#FAF8F5] p-3 text-[#D84315]">🌐 {lang === 'en' ? 'नेपालीमा हेर्नुहोस्' : 'View in English'}</a>
      </nav>
    </div>

    <div class="fixed bottom-0 left-0 right-0 z-50 flex items-center justify-between border-t border-[#e2e8f0] bg-white px-4 py-3 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] lg:hidden">
      <a href="https://wa.me/9779841459618" target="_blank" rel="noopener noreferrer" class="flex w-1/2 items-center justify-center gap-2 border-r border-[#e2e8f0] text-sm font-bold text-[#173A7A]">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        {t.mobileCall}
      </a>
      <a href="https://portal.nepalhypnosis.com/form/consultation-request" target="_blank" rel="noopener noreferrer" class="flex w-1/2 items-center justify-center gap-2 text-sm font-bold text-[#D84315]">
        {t.mobileBook} →
      </a>
    </div>

    <main id="main-content">
      <slot />
    </main>

    <footer class="bg-[#102f64] text-white">
      <div class="container-nh grid gap-10 py-16 md:grid-cols-4">
        
        <div>
          <div class="mb-5 flex items-center gap-3">
            <img src="/images/logo.jpg" alt="Nepal Hypnosis" width="48" height="48" class="h-12 w-auto rounded-lg bg-white p-1" />
            <div>
              <div class="font-[Poppins] text-sm font-extrabold">{lang === 'np' ? 'नेपाल हिप्नोसिस' : 'Nepal Hypnosis'}</div>
              <div class="text-[9px] font-bold uppercase tracking-widest text-blue-200">
                {lang === 'np' ? 'मनोचिकित्सा क्लिनिक तथा तालिम केन्द्र' : 'Psychotherapy Clinic & Training Center'}
              </div>
            </div>
          </div>
          <p class="mb-5 text-sm leading-relaxed text-blue-100">{t.footerIntro}</p>
          <ul class="text-sm text-blue-200 space-y-2 mb-6">
            <li><strong>📍 Location:</strong> Tangal, Kathmandu-5, Nepal</li>
            <li><strong>🕒 Hours:</strong> Sun - Fri, 10:00 AM - 5:00 PM</li>
            <li><strong>📞 Phone:</strong> +977-9841459618 (WhatsApp)</li>
            <li><strong>✉️ Email:</strong> info@nepalhypnosis.com</li>
          </ul>
        </div>

        <div>
          <h3 class="mb-5 text-xs font-bold uppercase tracking-wider text-white">{t.servicesHeading}</h3>
          <ul class="space-y-2.5 text-sm text-blue-100">
            {lang === 'np' ? (
              <>
                <li><a href="/np/services/psychotherapy/" class="hover:text-white transition">साइकोथेरापी</a></li>
                <li><a href="/np/insights/how-to-guide-children/" class="hover:text-white transition">बालबालिकालाई मार्गदर्शन</a></li>
                <li><a href="/np/insights/victory-over-lower-self-esteem/" class="hover:text-white transition">न्यून आत्मसम्मानमाथिको विजय</a></li>
                <li><a href="/np/insights/decreasing-generation-gap/" class="hover:text-white transition">पुस्तैनी दूरी कसरी घटाउने?</a></li>
                <li><a href="/np/insights/" class="hover:text-white transition">सबै लेखहरू </a></li>
                <li><a href="/np/clinical-standards" class="hover:text-white transition">नैतिक मापदण्ड</a></li>
              </>
            ) : (
              <>
                <li><a href="/services/psychotherapy/" class="hover:text-white transition">Psychotherapy</a></li>
                <li><a href="/services/clinical-hypnotherapy/" class="hover:text-white transition">Clinical Hypnotherapy</a></li>
                <li><a href="/insights/cognitive-behavioral-therapy/" class="hover:text-white transition">Cognitive Behavioral Therapy (CBT)</a></li>
                <li><a href="/insights/psychological-first-aid/" class="hover:text-white transition">Psychological First Aid (PFA)</a></li>
                <li><a href="/insights/importance-of-mental-health-interventions-in-nepal/" class="hover:text-white transition">Mental Health in Nepal</a></li>
                <li><a href="/insights/" class="hover:text-white transition">All Insights & Articles</a></li>
                <li><a href="/clinical-standards" class="hover:text-white transition">Clinical Standards & Ethics</a></li>
              </>
            )}
          </ul>
        </div>

        <div>
          <h3 class="mb-5 text-xs font-bold uppercase tracking-wider text-white">{t.academyHeading}</h3>
          <ul class="space-y-2.5 text-sm text-blue-100">
            <li><a href="/academy/" class="hover:text-white transition font-bold">Nepal Hypnosis Academy</a></li>
            <li><a href="/academy/puzzle-therapy-eclectic-therapist-training/" class="hover:text-white transition">Puzzle Therapy Training</a></li>
            <li><a href="/academy/self-esteem-training-series/" class="hover:text-white transition">Self-Esteem Series</a></li>
            <li><a href="/academy/self-hypnosis-workshop/" class="hover:text-white transition">Self-Hypnosis Workshop</a></li>
            <li class="pt-2"><a href={lang === 'np' ? '/np/team' : '/team'} class="hover:text-white transition">{t.team}</a></li>
            <li><a href={lang === 'np' ? '/np/about' : '/about'} class="hover:text-white transition">{t.about}</a></li>
          </ul>
        </div>

        <div>
          <h3 class="mb-5 text-xs font-bold uppercase tracking-wider text-white">{t.portalTitle}</h3>
          <p class="mb-5 text-sm leading-relaxed text-blue-100">{t.notice}</p>
          <a href="https://portal.nepalhypnosis.com/form/consultation-request" target="_blank" rel="noopener noreferrer" class="inline-flex rounded-lg border border-blue-300/40 px-4 py-2.5 text-xs font-bold text-white hover:bg-white/10 transition">
            {lang === 'np' ? 'ग्राहक पोर्टल →' : 'Client Portal →'}
          </a>
        </div>
      </div>

      <div class="border-t border-white/10 bg-[#0c244d] py-6 text-center text-[12px] text-blue-200">
        <div class="container-nh">
          {lang === 'np' ? (
            <p class="mb-3 rounded-lg bg-red-900/40 px-4 py-3 inline-block border border-red-800/50">
              🚨 <span class="font-bold text-white">आपत्कालीन सूचना:</span> यदि तपाईं वा कसैलाई तत्काल गम्भीर मानसिक संकट परेको छ भने, कृपया निःशुल्क राष्ट्रिय हेल्पलाइन <strong class="text-white text-[14px]">११६६ (1166)</strong> मा फोन गर्नुहोस्।
            </p>
          ) : (
            <p class="mb-3 rounded-lg bg-red-900/40 px-4 py-3 inline-block border border-red-800/50">
              🚨 <span class="font-bold text-white">Emergency Notice:</span> If you are experiencing an immediate mental health crisis, call <strong class="text-white text-[14px]">1166</strong> (Free National Helpline).
            </p>
          )}
          <p class="text-blue-300/80">© {new Date().getFullYear()} {t.rights}</p>
        </div>
      </div>
    </footer>

    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const closeBtn = document.getElementById('close-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileLinks = document.querySelectorAll('.mobile-link');

      function openMenu() {
        if (mobileMenu) {
          mobileMenu.hidden = false;
          requestAnimationFrame(() => {
            mobileMenu.classList.remove('translate-x-full');
            menuBtn?.setAttribute('aria-expanded', 'true');
          });
        }
      }

      function closeMenu() {
        if (mobileMenu) {
          mobileMenu.classList.add('translate-x-full');
          menuBtn?.setAttribute('aria-expanded', 'false');
          setTimeout(() => { if (mobileMenu) mobileMenu.hidden = true; }, 300);
        }
      }

      menuBtn?.addEventListener('click', openMenu);
      closeBtn?.addEventListener('click', closeMenu);
      mobileLinks.forEach(link => { link.addEventListener('click', closeMenu); });
    </script>
  </body>
</html>